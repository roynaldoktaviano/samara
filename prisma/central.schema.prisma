generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/@prisma/central-client"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("CENTRAL_DATABASE_URL")
  directUrl = env("CENTRAL_DIRECT_URL")
}

model CentralUser {
  id           String       @id @default(cuid())
  name         String?
  email        String       @unique
  password     String?      // only for super admins; tenant users auth via tenant DB
  isSuperAdmin Boolean      @default(false)
  isActive     Boolean      @default(true)
  tenants      UserTenant[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("central_users")
}

model Tenant {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  domain      String?
  databaseUrl String
  directUrl   String?
  logoUrl     String?
  isActive    Boolean      @default(true)
  features    Json?        // e.g. { "sharingCabin": true }
  secrets     Json?        // encrypted per-tenant integration credentials — see src/lib/tenant-secrets.ts, never returned decrypted from any list endpoint
  requestOrderToken String? @unique // unguessable token gating the public /request-order page for this tenant — see src/lib/resolve-tenant.ts
  users       UserTenant[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("tenants")
}

model UserTenant {
  id        String      @id @default(cuid())
  userId    String
  tenantId  String
  user      CentralUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([userId, tenantId])
  @@index([userId])
  @@map("user_tenants")
}

// Records every CF7 (or future webhook source) submission that got rejected
// before it could become a Lead — wrong/missing secret, unresolvable tenant
// slug, or a form payload with no recognizable name/email/phone. Lives in the
// central DB (not a tenant DB) because tenant resolution itself can be the
// thing that failed, so there may be no tenant database to write into yet.
model WebhookFailureLog {
  id         String   @id @default(cuid())
  source     String   // 'CF7'
  tenantSlug String?  // raw ?tenant= query value, even if it didn't resolve to a real tenant
  reason     String   // 'unknown_tenant' | 'unauthorized' | 'insufficient_contact_data' | 'exception'
  detail     String?  // exception message, when reason = 'exception'
  rawPayload Json?    // best-effort parsed form fields, for diagnosing why it was rejected
  createdAt  DateTime @default(now())

  @@index([source, createdAt])
  @@index([tenantSlug, createdAt])
  @@map("webhook_failure_logs")
}

model SuperAdminLog {
  id         String   @id @default(cuid())
  adminEmail String
  action     String   // CREATE_TENANT, UPDATE_TENANT, DELETE_USER, CREATE_USER, TOGGLE_FEATURE, etc.
  targetType String   // tenant, user
  targetId   String?
  detail     String?
  createdAt  DateTime @default(now())

  @@index([adminEmail])
  @@index([createdAt])
  @@map("super_admin_logs")
}
