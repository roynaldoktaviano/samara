generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/central-client"
}

datasource db {
  provider  = "postgresql"
  url       = env("CENTRAL_DATABASE_URL")
  directUrl = env("CENTRAL_DIRECT_URL")
}

model CentralUser {
  id           String       @id @default(cuid())
  name         String?
  email        String       @unique
  password     String?      // only for super admins; tenant users auth via tenant DB
  isSuperAdmin Boolean      @default(false)
  isActive     Boolean      @default(true)
  tenants      UserTenant[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("central_users")
}

model Tenant {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  domain      String?
  databaseUrl String
  directUrl   String?
  logoUrl     String?
  isActive    Boolean      @default(true)
  features    Json?        // e.g. { "sharingCabin": true }
  users       UserTenant[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("tenants")
}

model UserTenant {
  id        String      @id @default(cuid())
  userId    String
  tenantId  String
  user      CentralUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([userId, tenantId])
  @@index([userId])
  @@map("user_tenants")
}

model SuperAdminLog {
  id         String   @id @default(cuid())
  adminEmail String
  action     String   // CREATE_TENANT, UPDATE_TENANT, DELETE_USER, CREATE_USER, TOGGLE_FEATURE, etc.
  targetType String   // tenant, user
  targetId   String?
  detail     String?
  createdAt  DateTime @default(now())

  @@index([adminEmail])
  @@index([createdAt])
  @@map("super_admin_logs")
}
