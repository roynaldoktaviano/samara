generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  SALES
  FINANCE
  MARKETING
}

enum BookingSource {
  AGENT
  DIRECT
}

enum TripType {
  PRIVATE_CHARTER
  OPEN_TRIP
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      Role     @default(SALES)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id                  String         @id @default(cuid())
  name                String
  firstName           String?
  lastName            String?
  gender              String?
  email               String?
  phone               String?
  passport            String?
  dateOfBirth         DateTime?
  address             String?
  dietaryRequirements String?
  allergies           String?
  equipmentSizes      String?
  operationalNotes    String?
  deletedAt           DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  bookings            Booking[]
  guestOf             BookingGuest[]
}

model Agent {
  id         String    @id @default(cuid())
  name       String
  email      String?
  phone      String?
  company    String?
  commission Float     @default(0)
  isActive   Boolean   @default(true)
  bookings   Booking[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Yacht {
  id           String        @id @default(cuid())
  name         String
  model        String?
  year         Int?
  capacity     Int
  cabinCount   Int           @default(0)
  length       Float?
  description  String?
  hourlyRate   Float
  dailyRate    Float
  status       String        @default("available")
  image        String?
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  bookings     Booking[]
  crew         Crew[]
  cabins       Cabin[]
  openTrips    OpenTrip[]
  maintenances Maintenance[]
  expenses     Expense[]
}

model Cabin {
  id        String         @id @default(cuid())
  yachtId   String
  name      String
  capacity  Int            @default(2)
  price     Float          @default(0)
  deck      String?
  bedType   String?
  extraBeds Int            @default(0)
  yacht     Yacht          @relation(fields: [yachtId], references: [id], onDelete: Cascade)
  guests    BookingGuest[]
}

model OpenTrip {
  id             String    @id @default(cuid())
  title          String
  description    String?
  yachtId        String
  startDate      DateTime
  endDate        DateTime
  destination    String
  region         String?
  departurePort  String?
  arrivalPort    String?
  pricePerCabin  Float     @default(0)
  maxCapacity    Int       @default(0)
  status         String    @default("open")
  bookings       Booking[]
  yacht          Yacht     @relation(fields: [yachtId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Booking {
  id             String         @id @default(cuid())
  bookingCode    String         @unique
  customerId     String
  agentId        String?
  openTripId     String?
  source         BookingSource  @default(DIRECT)
  tripType       TripType       @default(PRIVATE_CHARTER)
  yachtId        String?
  startDate      DateTime
  endDate        DateTime
  destination    String?
  status         String         @default("pending")
  totalPrice     Float
  depositPaid    Float          @default(0)
  discount       Float          @default(0)
  depositDueDate DateTime?
  finalDueDate   DateTime?
  guestCount     Int            @default(1)
  crewRequired   Boolean        @default(false)
  salesperson    String?
  notes          String?
  voucherCode    String?
  currency       String         @default("USD")
  exchangeRate   Float?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  customer       Customer       @relation(fields: [customerId], references: [id])
  agent          Agent?         @relation(fields: [agentId], references: [id])
  yacht          Yacht?         @relation(fields: [yachtId], references: [id])
  openTrip       OpenTrip?      @relation(fields: [openTripId], references: [id])
  guests         BookingGuest[]
  services       BookingService[]
  payments       Payment[]
  expenses       Expense[]
  notifications  Notification[]

  @@index([status])
  @@index([openTripId, status])
  @@index([status, depositDueDate])
  @@index([customerId])
  @@index([startDate, endDate])
}

model BookingGuest {
  id         String   @id @default(cuid())
  bookingId  String
  customerId String
  cabinId    String?
  isLead     Boolean  @default(false)
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id])
  cabin      Cabin?   @relation(fields: [cabinId], references: [id])

  @@unique([bookingId, customerId])
}

model BookingService {
  id        String  @id @default(cuid())
  bookingId String
  name      String
  price     Float
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Crew {
  id        String    @id @default(cuid())
  yachtId   String
  name      String
  position  String
  phone     String?
  email     String?
  isActive  Boolean   @default(true)
  startDate DateTime  @default(now())
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  yacht     Yacht     @relation(fields: [yachtId], references: [id])
}

model Maintenance {
  id            String    @id @default(cuid())
  yachtId       String
  title         String
  description   String?
  scheduledDate DateTime
  completedAt   DateTime?
  status        String    @default("scheduled")
  cost          Float?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  yacht         Yacht     @relation(fields: [yachtId], references: [id], onDelete: Cascade)

  @@index([yachtId])
  @@index([status, scheduledDate])
}

model Expense {
  id          String   @id @default(cuid())
  category    String
  amount      Float
  description String?
  date        DateTime @default(now())
  yachtId     String?
  bookingId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  yacht       Yacht?   @relation(fields: [yachtId], references: [id], onDelete: SetNull)
  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([yachtId])
  @@index([bookingId])
  @@index([date])
}

model Payment {
  id                String    @id @default(cuid())
  bookingId         String
  invoiceNumber     String    @unique
  paymentType       String    @default("DP")
  amount            Float
  previouslyPaid    Float     @default(0)
  currency          String    @default("USD")
  status            String    @default("pending_confirmation")
  notes             String?
  proofOfTransfer   String?
  submittedByUserId String?
  submittedByName   String?
  confirmedBy       String?
  confirmedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  booking           Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  notifications     Notification[]

  @@index([bookingId])
  @@index([status])
}

model Voucher {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  description String?
  type        String    // PERCENTAGE | FIXED
  value       Float
  minBooking  Float?
  maxUses     Int?
  usedCount   Int       @default(0)
  validFrom   DateTime?
  validUntil  DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  userName  String
  userRole  String
  action    String
  entity    String?
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([entity, action])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  paymentId String?
  bookingId String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([userId])
  @@unique([userId, type, bookingId])
}
