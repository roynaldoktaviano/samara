generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  SALES
  FINANCE
  MARKETING
}

enum BookingSource {
  AGENT
  DIRECT
}

enum TripType {
  PRIVATE_CHARTER
  OPEN_TRIP
}

enum BookingStatus {
  on_hold
  pending
  partially_paid
  fully_paid
  completed
  cancelled
  confirmed
}

enum OpenTripStatus {
  open
  closed
  full
  completed
  cancelled
}

enum MaintenanceStatus {
  scheduled
  in_progress
  completed
  cancelled
}

enum YachtStatus {
  available
  booked
  maintenance
}

enum VoucherType {
  PERCENTAGE
  FIXED
}

enum WaitingListStatus {
  waiting
  promoted
  cancelled
}

enum PaymentStatus {
  requested
  invoice_ready
  pending_confirmation
  confirmed
  rejected
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String
  role          Role      @default(SALES)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  bookings         Booking[]     @relation("SalespersonBookings")
  managedAgents    Agent[]       @relation("AgentSalesperson")
  waitingListItems WaitingList[]
}

model Customer {
  id                  String         @id @default(cuid())
  name                String
  firstName           String?
  lastName            String?
  gender              String?
  email               String?
  phone               String?
  passport            String?
  dateOfBirth         DateTime?
  isChild             Boolean        @default(false)
  address             String?
  dietaryRequirements String?
  allergies           String?
  equipmentSizes      String?
  operationalNotes    String?
  nationality         String?
  passportExpiry      DateTime?
  emergencyContact    String?
  drinkPreferences    String?
  guestFormToken      String?        @unique
  guestFormExpiresAt  DateTime?
  medicalData         Json?
  foodData            Json?
  drinksData          Json?
  divingData          Json?
  passportImage       String?
  deletedAt           DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  bookings             Booking[]
  guestOf              BookingGuest[]
  waitingListItems     WaitingList[]
  waitingListHistories WaitingListHistory[] @relation("WaitingListHistoryCustomer")

  @@index([deletedAt])
  @@index([name])
  @@index([email])
  @@index([createdAt])
}

model Agent {
  id                 String               @id @default(cuid())
  name                      String
  commission                Float                @default(0)
  commissionOpenTrip        Float                @default(0)
  commissionPrivateCharter  Float                @default(0)
  isActive                  Boolean              @default(true)
  country            String?
  address            String?
  email              String?
  whatsapp           String?
  note               String?
  contract           String?
  contractFile       String?
  contractFileName   String?
  calendarToken      String?              @unique
  calendarActive     Boolean              @default(false)
  salespersonId      String?
  salesperson        User?                @relation("AgentSalesperson", fields: [salespersonId], references: [id], onDelete: SetNull)
  bookings           Booking[]
  contacts           AgentContact[]
  calendarAccessLogs CalendarAccessLog[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([salespersonId])
  @@index([name])
}

model CalendarAccessLog {
  id           String   @id @default(cuid())
  agentId      String
  agent        Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  ip           String?
  userAgent    String?
  isSuspicious Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([agentId])
  @@index([createdAt])
}

model AgentContact {
  id           String    @id @default(cuid())
  agentId      String
  name         String
  email        String?
  whatsapp     String?
  jobTitle     String?
  dateOfBirth  DateTime?
  addedById    String?
  addedByName  String?
  agent        Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  bookings     Booking[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@index([agentId])
}

model Yacht {
  id           String        @id @default(cuid())
  name         String
  model        String?
  year         Int?
  capacity     Int
  cabinCount   Int           @default(0)
  length       Float?
  description  String?
  hourlyRate     Float
  dailyRate      Float
  extraBedTiers  Json          @default("[]")
  canDiving      Boolean       @default(false)
  status         YachtStatus   @default(available)
  image        String?
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  bookings         Booking[]
  crew             Crew[]
  cabins           Cabin[]
  openTrips        OpenTrip[]
  maintenances     Maintenance[]
  expenses         Expense[]
  waitingListItems WaitingList[]
}

model Cabin {
  id            String             @id @default(cuid())
  yachtId       String
  name          String
  capacity      Int                @default(2)
  price         Float              @default(0)
  deck          String?
  bedType       String?
  extraBeds     Int                @default(0)
  yacht         Yacht              @relation(fields: [yachtId], references: [id], onDelete: Cascade)
  guests        BookingGuest[]
  pricingTiers  CabinPricingTier[]

  @@index([yachtId])
}

model CabinPricingTier {
  id      String @id @default(cuid())
  cabinId String
  nights  Int
  price   Float
  cabin   Cabin  @relation(fields: [cabinId], references: [id], onDelete: Cascade)

  @@unique([cabinId, nights])
  @@map("cabin_pricing_tiers")
}

model OpenTrip {
  id            String   @id @default(cuid())
  title         String
  description   String?
  yachtId       String
  startDate     DateTime
  endDate       DateTime
  destination   String
  region        String?
  departurePort String?
  arrivalPort   String?
  pricePerCabin Float    @default(0)
  maxCapacity   Int      @default(0)
  status        OpenTripStatus @default(open)
  closedReason  String?
  bookings         Booking[]
  waitingListItems WaitingList[]
  yacht            Yacht    @relation(fields: [yachtId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([yachtId])
  @@index([status])
  @@index([startDate, endDate])
}

model Booking {
  id             String          @id @default(cuid())
  bookingCode    String          @unique
  customerId     String
  agentId        String?
  agentContactId String?
  openTripId     String?
  source         BookingSource   @default(DIRECT)
  tripType       TripType        @default(PRIVATE_CHARTER)
  yachtId        String?
  startDate      DateTime
  endDate        DateTime
  destination    String?
  status         BookingStatus   @default(pending)
  totalPrice     Float
  depositPaid    Float           @default(0)
  discount       Float           @default(0)
  depositDueDate DateTime?
  finalDueDate   DateTime?
  holdUntil      DateTime?
  guestCount     Int             @default(1)
  crewRequired   Boolean         @default(false)
  hasDiving           Boolean         @default(false)
  masterFormToken     String?         @unique
  masterFormExpiresAt DateTime?
  salesperson     String?
  salespersonId   String?
  notes           String?
  cancelReason    String?
  voucherCode     String?
  currency        String          @default("USD")
  exchangeRate    Float?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  customer        Customer        @relation(fields: [customerId], references: [id])
  agent           Agent?          @relation(fields: [agentId], references: [id], onDelete: SetNull)
  agentContact    AgentContact?   @relation(fields: [agentContactId], references: [id], onDelete: SetNull)
  yacht           Yacht?          @relation(fields: [yachtId], references: [id])
  openTrip        OpenTrip?       @relation(fields: [openTripId], references: [id], onDelete: SetNull)
  salespersonUser User?           @relation("SalespersonBookings", fields: [salespersonId], references: [id], onDelete: SetNull)
  guests          BookingGuest[]
  services        BookingService[]
  payments        Payment[]
  expenses        Expense[]
  notifications   Notification[]
  waitingList          WaitingList[]        @relation("BookingWaitingList")
  slotHistory          WaitingListHistory[] @relation("BookingSlotHistory")
  promotedWaitingLists WaitingList[]        @relation("WaitingListPromotedBooking")

  @@index([status])
  @@index([openTripId, status])
  @@index([status, depositDueDate])
  @@index([customerId])
  @@index([startDate, endDate])
  @@index([yachtId])
  @@index([agentId])
  @@index([agentContactId])
  @@index([salespersonId])
  @@index([createdAt])
}

model BookingGuest {
  id                  String   @id @default(cuid())
  bookingId           String
  customerId          String
  cabinId             String?
  isLead              Boolean  @default(false)
  arrivalPickupTime   String?
  arrivalHotel        String?
  arrivalFlight       String?
  departurePickupTime String?
  departureHotel      String?
  departureFlight     String?
  booking             Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer            Customer @relation(fields: [customerId], references: [id])
  cabin               Cabin?   @relation(fields: [cabinId], references: [id])

  @@unique([bookingId, customerId])
  @@index([customerId])
  @@index([cabinId])
}

model BookingService {
  id        String  @id @default(cuid())
  bookingId String
  name      String
  price     Float
  quantity  Int     @default(1)
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model Crew {
  id        String    @id @default(cuid())
  yachtId   String
  name      String
  position  String
  phone     String?
  email     String?
  isActive  Boolean   @default(true)
  startDate DateTime  @default(now())
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  yacht     Yacht     @relation(fields: [yachtId], references: [id], onDelete: Cascade)

  @@index([yachtId])
}

model Maintenance {
  id            String    @id @default(cuid())
  yachtId       String
  title         String
  description   String?
  scheduledDate DateTime
  completedAt   DateTime?
  status        MaintenanceStatus @default(scheduled)
  cost          Float?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  yacht         Yacht     @relation(fields: [yachtId], references: [id], onDelete: Cascade)

  @@index([yachtId])
  @@index([status, scheduledDate])
}

model Expense {
  id          String   @id @default(cuid())
  category    String
  amount      Float
  description String?
  date        DateTime @default(now())
  yachtId     String?
  bookingId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  yacht       Yacht?   @relation(fields: [yachtId], references: [id], onDelete: SetNull)
  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([yachtId])
  @@index([bookingId])
  @@index([date])
}

model Bank {
  id              String    @id @default(cuid())
  name            String
  bankAddress     String?
  swiftCode       String?
  beneficiaryName String?
  idrAccount      String?
  usdAccount      String?
  address         String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  payments        Payment[]
}

model Payment {
  id                String    @id @default(cuid())
  bookingId         String
  invoiceNumber     String    @unique
  paymentType       String    @default("DP")
  paymentMethod     String?
  amount            Float
  previouslyPaid    Float     @default(0)
  currency          String    @default("USD")
  status            PaymentStatus @default(pending_confirmation)
  notes             String?
  proofOfTransfer     String?
  billToType          String?
  showNetAmount       Boolean   @default(false)
  bankId              String?
  paymentLink         String?
  submittedByUserId   String?
  submittedByName     String?
  invoiceGeneratedBy  String?
  invoiceGeneratedAt  DateTime?
  confirmedBy         String?
  confirmedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  booking           Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bank              Bank?          @relation(fields: [bankId], references: [id], onDelete: SetNull)
  notifications     Notification[]

  @@index([bookingId])
  @@index([status])
  @@index([bankId])
  @@index([createdAt])
}

model Voucher {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  description String?
  type        VoucherType
  value       Float
  minBooking  Float?
  maxUses     Int?
  usedCount   Int       @default(0)
  validFrom   DateTime?
  validUntil  DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  userName  String
  userRole  String
  action    String
  entity    String?
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([entity, action])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  paymentId String?
  bookingId String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([paymentId])
  @@index([bookingId])
  @@unique([userId, type, bookingId])
}

model WaitingList {
  id                String            @id @default(cuid())
  bookingId         String?
  yachtId           String?
  openTripId        String?
  startDate         DateTime
  endDate           DateTime
  customerId        String?
  contactName       String
  contactPhone      String?
  contactEmail      String?
  notes             String?
  priority          Int               @default(0)
  status            WaitingListStatus @default(waiting)
  salespersonId     String?
  promotedBookingId String?

  booking          Booking?   @relation("BookingWaitingList", fields: [bookingId], references: [id], onDelete: Cascade)
  yacht            Yacht?     @relation(fields: [yachtId], references: [id], onDelete: Cascade)
  openTrip         OpenTrip?  @relation(fields: [openTripId], references: [id], onDelete: Cascade)
  customer         Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  salesperson      User?      @relation(fields: [salespersonId], references: [id], onDelete: SetNull)
  promotedBooking  Booking?   @relation("WaitingListPromotedBooking", fields: [promotedBookingId], references: [id], onDelete: SetNull)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([bookingId, status])
  @@index([yachtId, status])
  @@index([openTripId, status])
  @@index([status])
  @@index([salespersonId])
  @@index([customerId])
}

model WaitingListHistory {
  id           String    @id @default(cuid())
  bookingId    String
  holderName   String
  customerId   String?
  cancelledAt  DateTime
  cancelReason String?
  createdAt    DateTime  @default(now())

  booking  Booking   @relation("BookingSlotHistory", fields: [bookingId], references: [id], onDelete: Cascade)
  customer Customer? @relation("WaitingListHistoryCustomer", fields: [customerId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([customerId])
}

model SystemSetting {
  key       String   @id
  textValue String?
  blobValue Bytes?
  mimeType  String?
  fileName  String?
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model Counter {
  key   String @id
  value Int    @default(0)
}
