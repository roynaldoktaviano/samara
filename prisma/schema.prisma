generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  SALES
  FINANCE
  MARKETING
  PURCHASING
  WAREHOUSE
  HR
}

enum BookingSource {
  AGENT
  DIRECT
}

enum TripType {
  PRIVATE_CHARTER
  OPEN_TRIP
}

enum BookingStatus {
  on_hold
  pending
  partially_paid
  fully_paid
  completed
  cancelled
  confirmed
  pending_refund
}

enum OpenTripStatus {
  open
  closed
  full
  completed
  cancelled
}

enum MaintenanceStatus {
  scheduled
  in_progress
  completed
  cancelled
}

enum YachtStatus {
  available
  booked
  maintenance
}

enum VoucherType {
  PERCENTAGE
  FIXED
}

enum WaitingListStatus {
  waiting
  promoted
  cancelled
}

enum PaymentStatus {
  requested
  invoice_ready
  pending_confirmation
  confirmed
  rejected
  cancelled
  refunded
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                             String                      @id @default(cuid())
  email                          String                      @unique
  name                           String?
  password                       String
  role                           Role                        @default(SALES)
  createdAt                      DateTime                    @default(now())
  updatedAt                      DateTime                    @updatedAt
  bookings                       Booking[]                   @relation("SalespersonBookings")
  managedAgents                  Agent[]                     @relation("AgentSalesperson")
  waitingListItems               WaitingList[]
  stockMovements                 StockMovement[]
  purchaseRequests               PurchaseRequest[]           @relation("PRRequestedBy")
  purchaseRequestsApproved       PurchaseRequest[]           @relation("PRApprovedBy")
  purchaseOrdersCreated          PurchaseOrder[]
  goodsReceipts                  GoodsReceipt[]
  transfersDispatched            StockTransfer[]             @relation("TransferDispatch")
  transfersReceived              StockTransfer[]             @relation("TransferReceive")
  transfersExpectedReceive       StockTransfer[]             @relation("TransferExpectedReceive")
  inventoryExceptionsResolved    InventoryException[]        @relation("ExceptionResolvedBy")
  crewRequests                   CrewRequest[]
  stockCountsBy                  StockCount[]                @relation("StockCountBy")
  stockCountsApproved            StockCount[]                @relation("StockCountApprove")
  poPaymentRequestsMade          POPaymentRequest[]          @relation("POPaymentRequestedBy")
  poPaymentRequestsPaid          POPaymentRequest[]          @relation("POPaymentPaidBy")
  poReimbursementsMade           POReimbursement[]           @relation("POReimbursementRequestedBy")
  poReimbursementsPaid           POReimbursement[]           @relation("POReimbursementPaidBy")
  deliveryFeesCreated            DeliveryFee[]
  deliveryFeePaymentRequestsMade DeliveryFeePaymentRequest[] @relation("DeliveryFeePaymentRequestedBy")
  deliveryFeePaymentRequestsPaid DeliveryFeePaymentRequest[] @relation("DeliveryFeePaymentPaidBy")
  deliveryFeeReimbursementsMade  DeliveryFeeReimbursement[]  @relation("DeliveryFeeReimbursementRequestedBy")
  deliveryFeeReimbursementsPaid  DeliveryFeeReimbursement[]  @relation("DeliveryFeeReimbursementPaidBy")
  agentLeadsPromoted             AgentLead[]                 @relation("AgentLeadPromotedBy")
}

model Customer {
  id                   String               @id @default(cuid())
  name                 String
  firstName            String?
  lastName             String?
  gender               String?
  email                String?
  phone                String?
  passport             String?
  dateOfBirth          DateTime?
  isChild              Boolean              @default(false)
  address              String?
  dietaryRequirements  String?
  allergies            String?
  equipmentSizes       String?
  operationalNotes     String?
  nationality          String?
  passportExpiry       DateTime?
  emergencyContact     String?
  drinkPreferences     String?
  guestFormToken       String?              @unique
  guestFormExpiresAt   DateTime?
  freshsalesContactId  String?              @unique
  medicalData          Json?
  foodData             Json?
  drinksData           Json?
  divingData           Json?
  surfingData          Json?
  passportImage        String?
  deletedAt            DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  bookings             Booking[]
  guestOf              BookingGuest[]
  waitingListItems     WaitingList[]
  waitingListHistories WaitingListHistory[] @relation("WaitingListHistoryCustomer")
  inquiries            Inquiry[]

  @@index([deletedAt])
  @@index([name])
  @@index([email])
  @@index([createdAt])
}

model Lead {
  id                  String    @id @default(cuid())
  name                String
  firstName           String?
  lastName            String?
  nationality         String?
  email               String?
  phone               String?
  notes               String?
  freshsalesContactId String?   @unique
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  inquiries Inquiry[]

  @@index([deletedAt])
  @@index([name])
  @@index([email])
  @@index([createdAt])
}

// One row per form/inquiry submission — links to whichever of Lead/Customer
// currently owns it (exactly one of leadId/customerId set; enforced in app
// code, not a DB constraint, matching this schema's other either/or relations).
// Reassigned from leadId to customerId when a Lead converts into a Guest via
// booking creation — see POST /api/bookings.
model Inquiry {
  id           String    @id @default(cuid())
  source       String
  leadId       String?
  customerId   String?
  checkInDate  DateTime?
  checkOutDate DateTime?
  guestCount   Int?
  tripType     String?
  message      String?
  website      String? // domain of the page the form was submitted from, e.g. "samaraliveaboard.com"
  url          String? // full URL of the page the form was submitted from
  // "Original" touch — first_source/first_medium/first_campaign in Freshsales
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmTerm      String?
  utmContent   String?
  gclid        String?
  leadSource   String? // Freshsales "Lead Source" (cf_lead_source)
  refererField String? // Freshsales "Referer Field" (cf_referer_field)
  mobileNumberBackup String? // Freshsales "Mobile number backup" (cf_mobile_number_backup)
  reference    String? // Freshsales "Reference" (cf_reference)
  // "Created from" touch — last_source/last_medium/last_campaign in Freshsales
  lastSource   String?
  lastMedium   String?
  lastCampaign String?
  // "Most recent" touch — latest_source/latest_medium/latest_campaign in Freshsales
  latestSource   String?
  latestMedium   String?
  latestCampaign String?
  rawPayload   Json?
  createdAt    DateTime  @default(now())

  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([customerId])
  @@index([createdAt])
}

model Agent {
  id                       String              @id @default(cuid())
  name                     String
  commission               Float               @default(0)
  commissionOpenTrip       Float               @default(0)
  commissionPrivateCharter Float               @default(0)
  isActive                 Boolean             @default(true)
  country                  String?
  address                  String?
  email                    String?
  whatsapp                 String?
  note                     String?
  website                  String?
  instagram                String?
  source                   String?
  currentCondition         String?
  contract                 String?
  contractFile             String?
  contractFileName         String?
  calendarToken            String?             @unique
  calendarActive           Boolean             @default(false)
  salespersonId            String?
  salesperson              User?               @relation("AgentSalesperson", fields: [salespersonId], references: [id], onDelete: SetNull)
  bookings                 Booking[]
  contacts                 AgentContact[]
  calendarAccessLogs       CalendarAccessLog[]
  leadsPromoted            AgentLead[]
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  @@index([salespersonId])
  @@index([name])
}

model CalendarAccessLog {
  id           String   @id @default(cuid())
  agentId      String
  agent        Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  ip           String?
  userAgent    String?
  isSuspicious Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([agentId])
  @@index([createdAt])
}

model AgentContact {
  id          String    @id @default(cuid())
  agentId     String
  name        String
  email       String?
  whatsapp    String?
  jobTitle    String?
  dateOfBirth DateTime?
  addedById   String?
  addedByName String?
  agent       Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  bookings    Booking[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([agentId])
}

enum AgentLeadStatus {
  NEW
  PROMOTED
  DISCARDED
}

// Staging area for agent contacts pulled from an external CRM (Freshsales) before
// they become real Agent records. Contacts sharing the same display_name in the
// source system are grouped into one AgentLead with multiple AgentLeadContact rows
// (e.g. "Nicholson Yachts" with two different emails) — reviewed and promoted by
// hand so the real Agent table never gets polluted with unqualified/duplicate leads.
model AgentLead {
  id              String             @id @default(cuid())
  name            String             @unique
  status          AgentLeadStatus    @default(NEW)
  promotedAgentId String?
  promotedAgent   Agent?             @relation(fields: [promotedAgentId], references: [id], onDelete: SetNull)
  promotedAt      DateTime?
  promotedById    String?
  promotedBy      User?              @relation("AgentLeadPromotedBy", fields: [promotedById], references: [id], onDelete: SetNull)
  discardedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  contacts        AgentLeadContact[]

  @@index([status])
}

model AgentLeadContact {
  id                  String   @id @default(cuid())
  agentLeadId         String
  freshsalesContactId String   @unique
  name                String
  email               String?
  whatsapp            String?
  jobTitle            String?
  salesOwnerName      String?
  createdAt           DateTime @default(now())

  agentLead AgentLead @relation(fields: [agentLeadId], references: [id], onDelete: Cascade)

  @@index([agentLeadId])
}

model Yacht {
  id                String                  @id @default(cuid())
  name              String
  model             String?
  year              Int?
  capacity          Int
  cabinCount        Int                     @default(0)
  length            Float?
  description       String?
  hourlyRate        Float
  dailyRate         Float
  extraBedTiers     Json                    @default("[]")
  canDiving         Boolean                 @default(false)
  canSurfing        Boolean                 @default(false)
  status            YachtStatus             @default(available)
  image             String?
  deletedAt         DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  bookings          Booking[]
  crew              Crew[]
  cabins            Cabin[]
  openTrips         OpenTrip[]
  maintenances      Maintenance[]
  expenses          Expense[]
  waitingListItems  WaitingList[]
  stockLocations    StockLocation[]
  crewRequests      CrewRequest[]
  cashierSales      CashierSale[]
  destinationPrices YachtDestinationPrice[]
}

model Destination {
  id        String    @id @default(cuid())
  name      String    @unique
  region    String?
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  yachtPrices YachtDestinationPrice[]
  openTrips   OpenTrip[]
  bookings    Booking[]
}

model YachtDestinationPrice {
  id            String      @id @default(cuid())
  yachtId       String
  destinationId String
  price         Float
  relocationFee Float?
  yacht         Yacht       @relation(fields: [yachtId], references: [id], onDelete: Cascade)
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([yachtId, destinationId])
}

model Cabin {
  id           String             @id @default(cuid())
  yachtId      String
  name         String
  capacity     Int                @default(2)
  price        Float              @default(0)
  deck         String?
  bedType      String?
  extraBeds    Int                @default(0)
  yacht        Yacht              @relation(fields: [yachtId], references: [id], onDelete: Cascade)
  guests       BookingGuest[]
  pricingTiers CabinPricingTier[]

  @@index([yachtId])
}

model CabinPricingTier {
  id      String @id @default(cuid())
  cabinId String
  nights  Int
  price   Float
  cabin   Cabin  @relation(fields: [cabinId], references: [id], onDelete: Cascade)

  @@unique([cabinId, nights])
  @@map("cabin_pricing_tiers")
}

model OpenTrip {
  id               String         @id @default(cuid())
  title            String
  description      String?
  yachtId          String
  startDate        DateTime
  endDate          DateTime
  destination      String
  destinationId    String?
  region           String?
  departurePort    String?
  arrivalPort      String?
  pricePerCabin    Float          @default(0)
  maxCapacity      Int            @default(0)
  status           OpenTripStatus @default(open)
  closedReason     String?
  bookings         Booking[]
  waitingListItems WaitingList[]
  yacht            Yacht          @relation(fields: [yachtId], references: [id], onDelete: Cascade)
  destinationRef   Destination?   @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([yachtId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([destinationId])
}

model Booking {
  id                            String               @id @default(cuid())
  bookingCode                   String               @unique
  customerId                    String
  agentId                       String?
  agentContactId                String?
  openTripId                    String?
  source                        BookingSource        @default(DIRECT)
  tripType                      TripType             @default(PRIVATE_CHARTER)
  yachtId                       String?
  startDate                     DateTime
  endDate                       DateTime
  destination                   String?
  destinationId                 String?
  status                        BookingStatus        @default(pending)
  totalPrice                    Float
  depositPaid                   Float                @default(0)
  discount                      Float                @default(0)
  depositDueDate                DateTime?
  finalDueDate                  DateTime?
  // When set, the invoice PDF shows this date instead of the live depositDueDate/finalDueDate above —
  // lets staff extend a due date internally without amending an already-issued invoice.
  depositDueDateInvoiceOverride DateTime?
  finalDueDateInvoiceOverride   DateTime?
  holdUntil                     DateTime?
  guestCount                    Int                  @default(1)
  crewRequired                  Boolean              @default(false)
  hasDiving                     Boolean              @default(false)
  hasSurfing                    Boolean              @default(false)
  hasPhotoPackage               Boolean              @default(false)
  masterFormToken               String?              @unique
  masterFormExpiresAt           DateTime?
  salesperson                   String?
  salespersonId                 String?
  notes                         String?
  cancelReason                  String?
  refundStatus                  String?
  refundDecision                String?
  refundReason                  String?
  refundProof                   String?
  refundConfirmedAt             DateTime?
  refundConfirmedBy             String?
  voucherCode                   String?
  currency                      String               @default("USD")
  exchangeRate                  Float?
  createdAt                     DateTime             @default(now())
  updatedAt                     DateTime             @updatedAt
  customer                      Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  agent                         Agent?               @relation(fields: [agentId], references: [id], onDelete: SetNull)
  agentContact                  AgentContact?        @relation(fields: [agentContactId], references: [id], onDelete: SetNull)
  yacht                         Yacht?               @relation(fields: [yachtId], references: [id])
  openTrip                      OpenTrip?            @relation(fields: [openTripId], references: [id], onDelete: SetNull)
  destinationRef                Destination?         @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  salespersonUser               User?                @relation("SalespersonBookings", fields: [salespersonId], references: [id], onDelete: SetNull)
  guests                        BookingGuest[]
  services                      BookingService[]
  payments                      Payment[]
  expenses                      Expense[]
  notifications                 Notification[]
  waitingList                   WaitingList[]        @relation("BookingWaitingList")
  slotHistory                   WaitingListHistory[] @relation("BookingSlotHistory")
  promotedWaitingLists          WaitingList[]        @relation("WaitingListPromotedBooking")
  cashierSales                  CashierSale[]
  purchaseOrders                PurchaseOrder[]

  @@index([status])
  @@index([openTripId, status])
  @@index([status, depositDueDate])
  @@index([customerId])
  @@index([startDate, endDate])
  @@index([yachtId])
  @@index([agentId])
  @@index([agentContactId])
  @@index([destinationId])
  @@index([salespersonId])
  @@index([createdAt])
}

model BookingGuest {
  id                  String        @id @default(cuid())
  bookingId           String
  customerId          String
  cabinId             String?
  isLead              Boolean       @default(false)
  arrivalPickupTime   String?
  arrivalHotel        String?
  arrivalFlight       String?
  departurePickupTime String?
  departureHotel      String?
  departureFlight     String?
  booking             Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer            Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  cabin               Cabin?        @relation(fields: [cabinId], references: [id])
  cashierSales        CashierSale[]

  @@unique([bookingId, customerId])
  @@index([customerId])
  @@index([cabinId])
}

model BookingService {
  id        String  @id @default(cuid())
  bookingId String
  name      String
  price     Float
  quantity  Int     @default(1)
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model Crew {
  id        String    @id @default(cuid())
  yachtId   String
  name      String
  position  String
  phone     String?
  email     String?
  isActive  Boolean   @default(true)
  startDate DateTime  @default(now())
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  yacht     Yacht     @relation(fields: [yachtId], references: [id], onDelete: Cascade)

  @@index([yachtId])
}

model Maintenance {
  id            String            @id @default(cuid())
  yachtId       String
  title         String
  description   String?
  scheduledDate DateTime
  completedAt   DateTime?
  status        MaintenanceStatus @default(scheduled)
  cost          Float?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  yacht         Yacht             @relation(fields: [yachtId], references: [id], onDelete: Cascade)

  @@index([yachtId])
  @@index([status, scheduledDate])
}

model Expense {
  id          String   @id @default(cuid())
  category    String
  amount      Float
  description String?
  date        DateTime @default(now())
  yachtId     String?
  bookingId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  yacht       Yacht?   @relation(fields: [yachtId], references: [id], onDelete: SetNull)
  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([yachtId])
  @@index([bookingId])
  @@index([date])
}

model Bank {
  id              String    @id @default(cuid())
  name            String
  bankAddress     String?
  swiftCode       String?
  beneficiaryName String?
  idrAccount      String?
  usdAccount      String?
  address         String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  payments        Payment[]
}

model Payment {
  id                 String         @id @default(cuid())
  bookingId          String
  invoiceNumber      String         @unique
  paymentType        String         @default("DP")
  paymentMethod      String?
  amount             Float
  previouslyPaid     Float          @default(0)
  paymentDate        DateTime?
  currency           String         @default("USD")
  exchangeRate       Float?
  status             PaymentStatus  @default(pending_confirmation)
  notes              String?
  proofOfTransfer    String?
  billToType         String?
  showNetAmount      Boolean        @default(false)
  showCommissionNote Boolean        @default(false)
  bankId             String?
  paymentLink        String?
  submittedByUserId  String?
  submittedByName    String?
  invoiceGeneratedBy String?
  invoiceGeneratedAt DateTime?
  confirmedBy        String?
  confirmedAt        DateTime?
  // hasDocument=false: an additional DP tacked onto parentPayment's invoice — no new invoice
  // document was generated, sales attaches proof of transfer directly at creation.
  hasDocument        Boolean        @default(true)
  parentPaymentId    String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  booking            Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bank               Bank?          @relation(fields: [bankId], references: [id], onDelete: SetNull)
  notifications      Notification[]
  parentPayment      Payment?       @relation("PaymentParent", fields: [parentPaymentId], references: [id], onDelete: SetNull)
  childPayments      Payment[]      @relation("PaymentParent")

  @@index([bookingId])
  @@index([status])
  @@index([status, bookingId])
  @@index([bankId])
  @@index([createdAt])
  @@index([parentPaymentId])
}

model NewsletterEmail {
  id           String                @id @default(cuid())
  subject      String
  bodyHtml     String
  fromEmail    String
  fromName     String?
  previewText  String?
  recipients   String[] // raw list entered at send time — no contact-list integration yet
  status       String                @default("sent") // sent | failed | partial
  resendIds    String[] // Resend message id per successful recipient
  errorMessage String?
  sentByUserId String?
  sentByName   String?
  createdAt    DateTime              @default(now())
  opens        NewsletterRecipient[]

  @@index([createdAt])
}

model NewsletterRecipient {
  id           String                 @id @default(cuid())
  newsletterId String
  newsletter   NewsletterEmail        @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
  email        String
  resendId     String?
  status       String                 @default("PENDING") // PENDING | SENT | FAILED
  errorMessage String?
  openedAt     DateTime?
  openCount    Int                    @default(0)
  clickedAt    DateTime?
  clickCount   Int                    @default(0)
  lastClickUrl String?
  clicks       NewsletterClickEvent[]
  opens        NewsletterOpenEvent[]
  createdAt    DateTime               @default(now())

  @@unique([newsletterId, email])
  @@index([newsletterId])
  @@index([resendId])
}

// One row per individual link click — lets the detail view show every link
// clicked (not just the most recent), since one email can have several CTAs.
model NewsletterClickEvent {
  id          String              @id @default(cuid())
  recipientId String
  recipient   NewsletterRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  url         String
  ipAddress   String?
  userAgent   String?
  clickedAt   DateTime            @default(now())

  @@index([recipientId])
}

// One row per individual open — lets the detail view chart opens by date/hour
// instead of only knowing the first-open timestamp.
model NewsletterOpenEvent {
  id          String              @id @default(cuid())
  recipientId String
  recipient   NewsletterRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  ipAddress   String?
  userAgent   String?
  openedAt    DateTime            @default(now())

  @@index([recipientId])
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  PAUSED   // send was interrupted mid-flight (e.g. server restart) — resumable, see src/instrumentation.ts
  SENT
  FAILED
  CANCELED
}

enum RecipientSourceType {
  CUSTOMER
  LEAD
  AGENT
  AGENT_LEAD_CONTACT
  MANUAL
}

enum RecipientStatus {
  PENDING
  SENT
  FAILED
  BOUNCED
  SKIPPED_UNSUBSCRIBED
}

model EmailTemplate {
  id              String          @id @default(cuid())
  name            String
  description     String?
  blocksJson      Json
  bodyHtml        String
  createdByUserId String?
  createdByName   String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  campaigns       EmailCampaign[]

  @@index([createdAt])
}

model EmailCampaign {
  id              String              @id @default(cuid())
  name            String
  subject         String
  previewText     String?
  fromEmail       String
  fromName        String?
  templateId      String?
  template        EmailTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  blocksJson      Json
  bodyHtml        String
  status          CampaignStatus      @default(DRAFT)
  audienceSources Json
  scheduledAt     DateTime?
  sentAt          DateTime?
  totalRecipients Int                 @default(0)
  sentCount       Int                 @default(0)
  failedCount     Int                 @default(0)
  errorMessage    String?
  createdByUserId String?
  createdByName   String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  recipients      CampaignRecipient[]

  @@index([status])
  @@index([scheduledAt])
  @@index([createdAt])
  @@index([templateId])
}

model CampaignRecipient {
  id               String               @id @default(cuid())
  campaignId       String
  campaign         EmailCampaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email            String
  name             String?
  sourceType       RecipientSourceType
  sourceId         String?
  status           RecipientStatus      @default(PENDING)
  resendId         String?
  errorMessage     String?
  unsubscribeToken String               @unique @default(cuid())
  sentAt           DateTime?
  openedAt         DateTime?
  openCount        Int                  @default(0)
  clickedAt        DateTime?
  clickCount       Int                  @default(0)
  lastClickUrl     String?
  unsubscribedAt   DateTime?
  clicks           CampaignClickEvent[]
  opens            CampaignOpenEvent[]
  createdAt        DateTime             @default(now())

  @@unique([campaignId, email])
  @@index([campaignId])
  @@index([campaignId, status])
  @@index([campaignId, status, openedAt])
  @@index([campaignId, status, sentAt])
  @@index([unsubscribeToken])
}

// One row per individual link click — lets the detail view show every link
// clicked (not just the most recent), since one email can have several CTAs.
model CampaignClickEvent {
  id          String            @id @default(cuid())
  recipientId String
  recipient   CampaignRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  url         String
  ipAddress   String?
  userAgent   String?
  clickedAt   DateTime          @default(now())

  @@index([recipientId])
}

// One row per individual open — lets the detail view chart opens by date/hour
// instead of only knowing the first-open timestamp.
model CampaignOpenEvent {
  id          String            @id @default(cuid())
  recipientId String
  recipient   CampaignRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  ipAddress   String?
  userAgent   String?
  openedAt    DateTime          @default(now())

  @@index([recipientId])
}

model EmailUnsubscribe {
  id         String   @id @default(cuid())
  email      String   @unique
  reason     String?
  campaignId String?
  createdAt  DateTime @default(now())
}

model Voucher {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  description String?
  type        VoucherType
  value       Float
  minBooking  Float?
  maxUses     Int?
  usedCount   Int         @default(0)
  validFrom   DateTime?
  validUntil  DateTime?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  userName  String
  userRole  String
  action    String
  entity    String?
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([entity, action])
}

model Notification {
  id              String           @id @default(cuid())
  userId          String
  type            String
  title           String
  body            String
  paymentId       String?
  bookingId       String?
  orderId         String?
  requestId       String?
  isRead          Boolean          @default(false)
  createdAt       DateTime         @default(now())
  payment         Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  booking         Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  purchaseOrder   PurchaseOrder?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  purchaseRequest PurchaseRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([paymentId])
  @@index([bookingId])
  @@index([orderId])
  @@index([requestId])
}

model WaitingList {
  id                String            @id @default(cuid())
  bookingId         String?
  yachtId           String?
  openTripId        String?
  startDate         DateTime
  endDate           DateTime
  customerId        String?
  contactName       String
  contactPhone      String?
  contactEmail      String?
  notes             String?
  priority          Int               @default(0)
  status            WaitingListStatus @default(waiting)
  salespersonId     String?
  promotedBookingId String?

  booking         Booking?  @relation("BookingWaitingList", fields: [bookingId], references: [id], onDelete: Cascade)
  yacht           Yacht?    @relation(fields: [yachtId], references: [id], onDelete: Cascade)
  openTrip        OpenTrip? @relation(fields: [openTripId], references: [id], onDelete: Cascade)
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  salesperson     User?     @relation(fields: [salespersonId], references: [id], onDelete: SetNull)
  promotedBooking Booking?  @relation("WaitingListPromotedBooking", fields: [promotedBookingId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([bookingId, status])
  @@index([yachtId, status])
  @@index([openTripId, status])
  @@index([status])
  @@index([salespersonId])
  @@index([customerId])
}

model WaitingListHistory {
  id           String   @id @default(cuid())
  bookingId    String
  holderName   String
  customerId   String?
  cancelledAt  DateTime
  cancelReason String?
  createdAt    DateTime @default(now())

  booking  Booking   @relation("BookingSlotHistory", fields: [bookingId], references: [id], onDelete: Cascade)
  customer Customer? @relation("WaitingListHistoryCustomer", fields: [customerId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([customerId])
}

model SystemSetting {
  key       String   @id
  textValue String?
  blobValue Bytes?
  mimeType  String?
  fileName  String?
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model Counter {
  key   String @id
  value Int    @default(0)
}

// ─── Purchasing & Inventory ────────────────────────────────────────────────────

enum StockLocationType {
  WAREHOUSE
  VESSEL
  TRANSIT
  SITE
  ADJUSTMENT
}

model PurchaseItemTypeConfig {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String
  isLocked  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories PurchaseItemCategory[]
}

model PurchaseItemCategory {
  id        String                 @id @default(cuid())
  typeCode  String
  type      PurchaseItemTypeConfig @relation(fields: [typeCode], references: [code], onDelete: Cascade)
  name      String
  skuPrefix String                 @default("")
  isActive  Boolean                @default(true)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@unique([typeCode, name])
}

// Simplified from an 8-value enum (DRAFT/SENT/ORDERED/PARTIALLY_RECEIVED/RECEIVED
// were either dead states never set by any code path, or duplicated tracking that
// already belongs to the linked PurchaseOrder — see PurchaseOrderStatus).
enum PurchaseRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  IN_TRANSIT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum TransferStatus {
  PENDING
  DISPATCHED
  RECEIVED
  CANCELLED
}

enum CrewRequestStatus {
  PENDING
  REVIEWED
  IN_PROGRESS
  FULFILLED
  CANCELLED
}

enum StockCountStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  APPROVED
}

model PurchaseItem {
  id               String   @id @default(cuid())
  sku              String   @unique
  name             String
  type             String   @default("MAINTENANCE")
  category         String
  baseUnit         String
  purchaseUnit     String
  conversionFactor Float    @default(1)
  standardCost     Float    @default(0)
  sellingPrice     Float    @default(0)
  valuationMethod  String   @default("FIFO")
  minStock         Float    @default(0)
  reorderQty       Float    @default(0)
  imageKey         String?
  isActive         Boolean  @default(true)
  isSoldInPos      Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  stockLots        StockLot[]
  requestItems     PurchaseRequestItem[]
  orderItems       PurchaseOrderItem[]
  receiptItems     GoodsReceiptItem[]
  transferItems    StockTransferItem[]
  crewRequestItems CrewRequestItem[]
  movements        StockMovement[]
  stockCountItems  StockCountItem[]
  cashierSaleItems CashierSaleItem[]

  @@index([name])
  @@index([category])
}

model StockLocation {
  id           String            @id @default(cuid())
  name         String
  type         StockLocationType @default(WAREHOUSE)
  yachtId      String?
  parentId     String?
  manager      String?
  storageClass String?
  managedBy    String            @default("WAREHOUSE")
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())

  yacht            Yacht?            @relation(fields: [yachtId], references: [id], onDelete: SetNull)
  parent           StockLocation?    @relation("LocationParent", fields: [parentId], references: [id], onDelete: SetNull)
  children         StockLocation[]   @relation("LocationParent")
  stockLots        StockLot[]
  transfersFrom    StockTransfer[]   @relation("TransferFrom")
  transfersTo      StockTransfer[]   @relation("TransferTo")
  receipts         GoodsReceipt[]
  stockCounts      StockCount[]
  purchaseRequests PurchaseRequest[] @relation("PRDelivery")
  purchaseOrders   PurchaseOrder[]   @relation("PODelivery")
  cashierSales     CashierSale[]
  employees        Employee[]

  @@index([type])
  @@index([yachtId])
  @@index([parentId])
}

model CashierSale {
  id         String    @id @default(cuid())
  yachtId    String
  locationId String
  bookingId  String?
  guestId    String?
  guestName  String?
  status     String    @default("open") // open | closed
  payMethod  String?
  total      Float     @default(0)
  openedBy   String?
  closedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  yacht    Yacht             @relation(fields: [yachtId], references: [id])
  location StockLocation     @relation(fields: [locationId], references: [id])
  booking  Booking?          @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  guest    BookingGuest?     @relation(fields: [guestId], references: [id], onDelete: SetNull)
  items    CashierSaleItem[]

  @@index([yachtId])
  @@index([bookingId])
  @@index([status])
  @@index([createdAt])
}

model CashierSaleItem {
  id        String   @id @default(cuid())
  saleId    String
  itemId    String?
  name      String
  unit      String
  price     Float
  qty       Float
  round     Int      @default(1)
  createdAt DateTime @default(now())

  sale CashierSale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  item PurchaseItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([itemId])
}

model StockLot {
  id          String    @id @default(cuid())
  itemId      String?
  // Fallback label for PO items not linked to the PurchaseItem catalog (e.g.
  // one-off purchases like "Grab" or event flowers) — set only when itemId is null.
  itemName    String?
  unit        String?
  // Which PO this lot was received against — only ever set for non-catalog
  // ("non-stock") lots. Unlike catalog lots (which merge into one running
  // balance per item+location, since stock is fungible), each receipt of a
  // non-catalog item creates its OWN lot instead of merging into a prior one,
  // so it stays individually traceable to the PO/date/cost that brought it in.
  sourcePoId  String?
  locationId  String
  quantity    Float     @default(0)
  costPerUnit Float     @default(0)
  batch       String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  item     PurchaseItem?  @relation(fields: [itemId], references: [id])
  location StockLocation @relation(fields: [locationId], references: [id])
  sourcePo PurchaseOrder? @relation(fields: [sourcePoId], references: [id], onDelete: SetNull)

  @@index([itemId, locationId])
  @@index([itemName, locationId])
  @@index([sourcePoId])
  @@index([expiresAt])
}

model StockMovement {
  id             String   @id @default(cuid())
  itemId         String?
  // Fallback label for non-catalog PO items — see StockLot.itemName.
  itemName       String?
  fromLocationId String?
  toLocationId   String?
  quantity       Float
  type           String
  referenceId    String?
  referenceType  String?
  notes          String?
  createdById    String
  createdAt      DateTime @default(now())

  item      PurchaseItem? @relation(fields: [itemId], references: [id])
  createdBy User         @relation(fields: [createdById], references: [id])

  @@index([itemId])
  @@index([itemName])
  @@index([type])
  @@index([createdAt])
  @@index([referenceId])
}

model PurchaseRequest {
  id                    String                @id @default(cuid())
  prNumber              String                @unique
  requestedById         String
  requestedByEmployeeId String?
  deliveryLocationId    String?
  notes                 String?
  status                PurchaseRequestStatus @default(REQUESTED)
  pdfKey                String?
  approvedById          String?
  approvedAt            DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  requestedBy         User                  @relation("PRRequestedBy", fields: [requestedById], references: [id])
  requestedByEmployee Employee?             @relation(fields: [requestedByEmployeeId], references: [id], onDelete: SetNull)
  deliveryLocation    StockLocation?        @relation("PRDelivery", fields: [deliveryLocationId], references: [id], onDelete: SetNull)
  approvedBy          User?                 @relation("PRApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  items               PurchaseRequestItem[]
  orders              PurchaseOrder[]
  transfers           StockTransfer[]
  notifications       Notification[]

  @@index([status])
  @@index([createdAt])
  @@index([requestedById])
  @@index([requestedByEmployeeId])
  @@index([deliveryLocationId])
  @@index([approvedById])
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  locations Json     @default("[]")
  contact   String?
  phone     String?
  email     String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders       PurchaseOrder[]
  requestItems PurchaseRequestItem[]
}

// Saved bank accounts for PO reimbursements — lets Purchasing/Admin pick a
// previously-used account instead of retyping bank details every time.
model ReimburseAccount {
  id                String   @id @default(cuid())
  accountHolderName String
  bankName          String
  accountNumber     String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([accountHolderName])
}

model PurchaseRequestItem {
  id            String  @id @default(cuid())
  requestId     String
  itemId        String?
  itemName      String
  quantity      Float
  unit          String
  estimatedCost Float   @default(0)
  supplierId    String?
  supplierName  String?
  notes         String?
  imageKeys     Json    @default("[]") // reference photos for custom requests — array of base64/URL strings

  request  PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  item     PurchaseItem?   @relation(fields: [itemId], references: [id], onDelete: SetNull)
  supplier Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([requestId])
}

model PurchaseOrder {
  id                 String              @id @default(cuid())
  poNumber           String              @unique
  requestId          String?
  supplierId         String?
  supplierName       String?
  deliveryLocationId String?
  // Which trip/booking this PO's goods are for — optional (a lot of purchasing is
  // general stock, not tied to one trip), set at creation, editable same as everything else.
  bookingId          String?
  status             PurchaseOrderStatus @default(ORDERED)
  dispatchPhotoKey   String?
  dispatchedAt       DateTime?
  dispatchedByName   String?
  confirmedByName    String?
  notes              String?
  orderedAt          DateTime            @default(now())
  expectedAt         DateTime?
  cancelledAt        DateTime?
  cancelledByName    String?
  cancellationReason String?
  createdById        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  // Additional pricing lines beyond item subtotal (tax/VAT, fees, etc.) — [{ label, amount }].
  // Set once at PO creation, shown above Order Total; not editable afterward, same as items.
  extraCharges Json?

  // Discount applied to the item subtotal BEFORE extraCharges are added on top.
  // discountType 'PERCENT' means discountValue is a % of the item subtotal; 'FIXED' means a flat Rupiah amount.
  discountType  String?
  discountValue Float   @default(0)

  // Requester snapshot — captured at PO creation time (direct create, or auto-created from an
  // approved PR) so department/office/role stay historically accurate even if the employee's
  // record changes later.
  requestedByEmployeeId String?
  requestedByName       String?
  requestedByOffice     String?
  requestedByDepartment String?
  requestedByRole       String?

  request             PurchaseRequest?    @relation(fields: [requestId], references: [id], onDelete: SetNull)
  supplier            Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  deliveryLocation    StockLocation?      @relation("PODelivery", fields: [deliveryLocationId], references: [id], onDelete: SetNull)
  createdBy           User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  requestedByEmployee Employee?           @relation(fields: [requestedByEmployeeId], references: [id], onDelete: SetNull)
  booking             Booking?            @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  items               PurchaseOrderItem[]
  receipts            GoodsReceipt[]
  notifications       Notification[]
  paymentRequests     POPaymentRequest[]
  reimbursements      POReimbursement[]
  deliveryFees        DeliveryFee[]
  stockLots           StockLot[]

  @@index([createdById])
  @@index([status])
  @@index([createdAt])
  @@index([requestId])
  @@index([deliveryLocationId])
  @@index([requestedByEmployeeId])
  @@index([bookingId])
}

enum POPaymentRequestStatus {
  PENDING
  PAID
}

model POPaymentRequest {
  id                String                 @id @default(cuid())
  orderId           String
  requestedById     String
  amount            Float
  notePhotoKeys     String[]               @default([])
  notes             String?
  status            POPaymentRequestStatus @default(PENDING)
  paymentMethod     String                 @default("TRANSFER")
  paidAt            DateTime?
  paidById          String?
  transferProofKeys String[]               @default([])
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  order       PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedBy User          @relation("POPaymentRequestedBy", fields: [requestedById], references: [id])
  paidBy      User?         @relation("POPaymentPaidBy", fields: [paidById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
  @@index([requestedById])
}

enum POReimbursementStatus {
  PENDING
  PAID
}

model POReimbursement {
  id                String                @id @default(cuid())
  orderId           String
  requestedById     String
  amount            Float
  notePhotoKeys     String[]              @default([])
  notes             String?
  requesterName     String
  bankName          String
  accountNumber     String
  accountHolderName String
  status            POReimbursementStatus @default(PENDING)
  paidAt            DateTime?
  paidById          String?
  transferProofKeys String[]              @default([])
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  order       PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedBy User          @relation("POReimbursementRequestedBy", fields: [requestedById], references: [id])
  paidBy      User?         @relation("POReimbursementPaidBy", fields: [paidById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
  @@index([requestedById])
}

// A delivery/shipping fee, usually tied to an existing PO ("which PO's goods this
// shipment cost covers") but not required to be — a shipment can consolidate
// several POs or be a standalone cargo delivery with no single PO behind it.
// No items of its own. Goes through the same Request Payment / Debit Paid /
// Reimburse flow as a Purchase Order.
model DeliveryFee {
  id              String   @id @default(cuid())
  feeNumber       String   @unique
  purchaseOrderId String?
  notes           String?
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseOrder   PurchaseOrder?              @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  createdBy       User?                       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  paymentRequests DeliveryFeePaymentRequest[]
  reimbursements  DeliveryFeeReimbursement[]

  @@index([purchaseOrderId])
  @@index([createdById])
  @@index([createdAt])
}

enum DeliveryFeePaymentRequestStatus {
  PENDING
  PAID
}

model DeliveryFeePaymentRequest {
  id                String                          @id @default(cuid())
  deliveryFeeId     String
  requestedById     String
  amount            Float
  notePhotoKeys     String[]                        @default([])
  notes             String?
  status            DeliveryFeePaymentRequestStatus @default(PENDING)
  paymentMethod     String                          @default("TRANSFER")
  paidAt            DateTime?
  paidById          String?
  transferProofKeys String[]                        @default([])
  createdAt         DateTime                        @default(now())
  updatedAt         DateTime                        @updatedAt

  deliveryFee DeliveryFee @relation(fields: [deliveryFeeId], references: [id], onDelete: Cascade)
  requestedBy User        @relation("DeliveryFeePaymentRequestedBy", fields: [requestedById], references: [id])
  paidBy      User?       @relation("DeliveryFeePaymentPaidBy", fields: [paidById], references: [id], onDelete: SetNull)

  @@index([deliveryFeeId])
  @@index([status])
  @@index([requestedById])
}

enum DeliveryFeeReimbursementStatus {
  PENDING
  PAID
}

model DeliveryFeeReimbursement {
  id                String                         @id @default(cuid())
  deliveryFeeId     String
  requestedById     String
  amount            Float
  notePhotoKeys     String[]                       @default([])
  notes             String?
  requesterName     String
  bankName          String
  accountNumber     String
  accountHolderName String
  status            DeliveryFeeReimbursementStatus @default(PENDING)
  paidAt            DateTime?
  paidById          String?
  transferProofKeys String[]                       @default([])
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt

  deliveryFee DeliveryFee @relation(fields: [deliveryFeeId], references: [id], onDelete: Cascade)
  requestedBy User        @relation("DeliveryFeeReimbursementRequestedBy", fields: [requestedById], references: [id])
  paidBy      User?       @relation("DeliveryFeeReimbursementPaidBy", fields: [paidById], references: [id], onDelete: SetNull)

  @@index([deliveryFeeId])
  @@index([status])
  @@index([requestedById])
}

model PurchaseOrderItem {
  id          String  @id @default(cuid())
  orderId     String
  itemId      String?
  itemName    String
  unit        String?
  orderedQty  Float
  receivedQty Float   @default(0)
  unitCost    Float   @default(0)

  order PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item  PurchaseItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model GoodsReceipt {
  id              String   @id @default(cuid())
  grNumber        String   @unique
  orderId         String
  receivedById    String
  receiverName    String?
  locationId      String
  receivePhotoKey String?
  notes           String?
  receivedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  order      PurchaseOrder      @relation(fields: [orderId], references: [id])
  receivedBy User               @relation(fields: [receivedById], references: [id])
  location   StockLocation      @relation(fields: [locationId], references: [id])
  items      GoodsReceiptItem[]

  @@index([orderId])
  @@index([receivedAt])
}

model GoodsReceiptItem {
  id          String    @id @default(cuid())
  receiptId   String
  itemId      String?
  itemName    String
  receivedQty Float
  unitCost    Float     @default(0)
  outcome     String    @default("ACCEPTED")
  condition   String    @default("good")
  batch       String?
  expiryDate  DateTime?
  notes       String?

  receipt GoodsReceipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  item    PurchaseItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([receiptId])
}

model StockTransfer {
  id                   String         @id @default(cuid())
  transferNumber       String         @unique
  fromLocationId       String
  toLocationId         String
  crewRequestId        String?
  purchaseRequestId    String?
  status               TransferStatus @default(PENDING)
  dispatchPhotoKey     String?
  receivePhotoKey      String?
  dispatchedById       String?
  receivedById         String?
  expectedReceiverId   String?
  expectedReceiverName String?
  receivedByName       String?
  notes                String?
  dispatchedAt         DateTime?
  receivedAt           DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  fromLocation       StockLocation       @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocation         StockLocation       @relation("TransferTo", fields: [toLocationId], references: [id])
  crewRequest        CrewRequest?        @relation(fields: [crewRequestId], references: [id], onDelete: SetNull)
  purchaseRequest    PurchaseRequest?    @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull)
  dispatchedBy       User?               @relation("TransferDispatch", fields: [dispatchedById], references: [id], onDelete: SetNull)
  receivedBy         User?               @relation("TransferReceive", fields: [receivedById], references: [id], onDelete: SetNull)
  expectedReceivedBy User?               @relation("TransferExpectedReceive", fields: [expectedReceiverId], references: [id], onDelete: SetNull)
  items              StockTransferItem[]

  @@index([status])
  @@index([createdAt])
  @@index([crewRequestId])
  @@index([purchaseRequestId])
}

model StockTransferItem {
  id            String  @id @default(cuid())
  transferId    String
  itemId        String?
  itemName      String
  requestedQty  Float
  dispatchedQty Float   @default(0)
  receivedQty   Float   @default(0)

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  item     PurchaseItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([transferId])
}

model StockCount {
  id           String           @id @default(cuid())
  countNumber  String           @unique
  locationId   String
  status       StockCountStatus @default(DRAFT)
  notes        String?
  photoKey     String?
  countedById  String
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  location   StockLocation    @relation(fields: [locationId], references: [id])
  countedBy  User             @relation("StockCountBy", fields: [countedById], references: [id])
  approvedBy User?            @relation("StockCountApprove", fields: [approvedById], references: [id], onDelete: SetNull)
  items      StockCountItem[]

  @@index([status])
  @@index([locationId])
  @@index([createdAt])
}

model StockCountItem {
  id         String  @id @default(cuid())
  countId    String
  itemId     String?
  itemName   String
  systemQty  Float
  countedQty Float   @default(0)
  reason     String?

  count StockCount    @relation(fields: [countId], references: [id], onDelete: Cascade)
  item  PurchaseItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([countId])
}

model CrewRequest {
  id            String            @id @default(cuid())
  yachtId       String
  requestedById String
  status        CrewRequestStatus @default(PENDING)
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  yacht       Yacht             @relation(fields: [yachtId], references: [id])
  requestedBy User              @relation(fields: [requestedById], references: [id])
  items       CrewRequestItem[]
  transfers   StockTransfer[]

  @@index([yachtId, status])
  @@index([status])
  @@index([createdAt])
}

model CrewRequestItem {
  id        String  @id @default(cuid())
  requestId String
  itemId    String?
  itemName  String
  quantity  Float
  unit      String
  notes     String?

  request CrewRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  item    PurchaseItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([requestId])
}

model InventoryException {
  id            String    @id @default(cuid())
  type          String // TRANSFER_DISCREPANCY | NEGATIVE_STOCK | RECEIVING_DISCREPANCY | STOCK_COUNT_VARIANCE
  itemId        String?
  itemName      String
  locationId    String?
  locationName  String
  qty           Float     @default(0)
  value         Float     @default(0)
  reason        String?
  referenceId   String?
  referenceType String?
  status        String    @default("OPEN")
  resolution    String?
  resolvedAt    DateTime?
  resolvedById  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  resolvedBy User? @relation("ExceptionResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([referenceId])
}

// ─── People & HR (minimal master data) ─────────────────────────────────────────

model LegalEntity {
  id        String   @id @default(cuid())
  name      String
  code      String?  @unique
  country   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  employees Employee[]
}

model EmployeeRole {
  id        String   @id @default(cuid())
  title     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  employees Employee[]

  @@index([title])
}

model Employee {
  id               String    @id @default(cuid())
  employeeNumber   String    @unique
  fullName         String
  department       String?
  gender           String?
  employmentStatus String? // e.g. Permanent | Contract | Probation | Intern
  leaveBalance     Int?
  joinDate         DateTime?
  isActive         Boolean   @default(true)
  resignedAt       DateTime?
  resignStatus     String? // RESIGNED | TERMINATED | CONTRACT_ENDED | OTHER
  resignReason     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  legalEntityId String?
  legalEntity   LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)

  locationId String?
  location   StockLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  roleId String?
  role   EmployeeRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  purchaseRequests        PurchaseRequest[]
  purchaseOrdersRequested PurchaseOrder[]

  @@index([legalEntityId])
  @@index([locationId])
  @@index([roleId])
  @@index([fullName])
}
