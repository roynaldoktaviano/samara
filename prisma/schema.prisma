// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id          String    @id @default(cuid())
  name        String
  email       String?
  phone       String?
  address     String?
  companyName String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bookings    Booking[]
}

model Yacht {
  id          String     @id @default(cuid())
  name        String
  model       String?
  year        Int?
  capacity    Int
  cabins      Int
  length      Float?
  description String?
  hourlyRate  Float
  dailyRate   Float
  status      String     @default("available")
  image       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  bookings    Booking[]
  crew        Crew[]
}

model Booking {
  id           String   @id @default(cuid())
  bookingCode  String   @unique
  yachtId      String
  customerId   String
  startDate    DateTime
  endDate      DateTime
  status       String   @default("confirmed")
  totalPrice   Float
  depositPaid  Float    @default(0)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  yacht        Yacht    @relation(fields: [yachtId], references: [id])
  customer     Customer @relation(fields: [customerId], references: [id])
}

model Crew {
  id        String   @id @default(cuid())
  yachtId   String
  name      String
  position  String
  phone     String?
  email     String?
  startDate DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  yacht     Yacht    @relation(fields: [yachtId], references: [id])
}

model Maintenance {
  id          String   @id @default(cuid())
  yachtId     String
  title       String
  description String?
  scheduledDate DateTime
  completedAt DateTime?
  status      String   @default("scheduled")
  cost        Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Expense {
  id          String   @id @default(cuid())
  category    String
  amount      Float
  description String?
  date        DateTime @default(now())
  yachtId     String?
  bookingId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}