// DRAFT: newly submitted, awaiting Purchasing review. ON_PROCESS: verified by
// Purchasing and being worked (supplier/pricing/warehouse-fulfillment picks)
// before conversion. CONVERTED: turned into one or more PurchaseOrders — see
// PurchaseOrderStatus for what happens to the goods from there.
enum PurchaseRequestStatus {
  DRAFT
  PENDING_APPROVAL
  ON_PROCESS
  CONVERTED
  REJECTED
  CANCELLED
}

// Which Purchasing staffer's queue a PR belongs to (distinct from Purpose above, which
// is about what the request is FOR, not who handles it). Set from the public Request
// Order form's "What is this for?" picker; internally-created PRs stay unset (null),
// which every Purchasing user can still see — see purchasingDivision on User for the
// per-staffer assignment side of this, and notify-purchasing.ts for how it's routed.
enum PurchaseRequestDivision {
  BOAT_OPERATION
  BUILDING_MATERIAL
}

enum PurchaseRequestPurpose {
  STOCK_INVENTORY
  TRIP
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  IN_TRANSIT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum TransferStatus {
  PENDING
  DISPATCHED
  RECEIVED
  CANCELLED
}

enum CrewRequestStatus {
  PENDING
  REVIEWED
  IN_PROGRESS
  FULFILLED
  CANCELLED
}

enum StockCountStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  APPROVED
}

model PurchaseItem {
  id                String   @id @default(cuid())
  sku               String   @unique
  name              String
  type              String   @default("MAINTENANCE")
  category          String
  baseUnit          String
  purchaseUnit      String
  conversionFactor  Float    @default(1)
  standardCost      Float    @default(0)
  sellingPrice      Float    @default(0)
  valuationMethod   String   @default("FIFO")
  minStock          Float    @default(0)
  reorderQty        Float    @default(0)
  imageKey          String?
  isActive          Boolean  @default(true)
  isSoldInPos       Boolean  @default(true)
  // false for items that are purchased but never held as inventory (services, one-off
  // buys promoted from a PR/PO "Custom Request" line) — receiveGoods() still logs their
  // receipt for history, but never pools them into a location's stock balance, and they
  // never trigger min-stock/reorder logic. Default true keeps every existing catalog row
  // (all of which are real stock items today) unaffected.
  isStockTracked    Boolean  @default(true)
  // Where a non-stock item currently physically sits — manually set (see "Change
  // Location" in Items & Pricing), since these items are never pooled into StockLot
  // balances and so have no other way to answer "where is it right now". Meaningless
  // for stock-tracked items, which already have a real location breakdown via StockLot.
  currentLocationId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  stockLots        StockLot[]
  requestItems     PurchaseRequestItem[]
  orderItems       PurchaseOrderItem[]
  receiptItems     GoodsReceiptItem[]
  transferItems    StockTransferItem[]
  crewRequestItems CrewRequestItem[]
  movements        StockMovement[]
  stockCountItems  StockCountItem[]
  cashierSaleItems CashierSaleItem[]
  currentLocation  StockLocation?        @relation("PurchaseItemCurrentLocation", fields: [currentLocationId], references: [id], onDelete: SetNull)
  posMenuItems     PosMenuItem[]
  posPackageItems  PosPackageItem[]

  @@index([name])
  @@index([category])
  @@index([currentLocationId])
}

model StockLocation {
  id           String            @id @default(cuid())
  name         String
  type         StockLocationType @default(WAREHOUSE)
  yachtId      String?
  parentId     String?
  manager      String?
  address      String?
  storageClass String?
  managedBy    String            @default("WAREHOUSE")
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())

  yacht             Yacht?                     @relation(fields: [yachtId], references: [id], onDelete: SetNull)
  parent            StockLocation?             @relation("LocationParent", fields: [parentId], references: [id], onDelete: SetNull)
  children          StockLocation[]            @relation("LocationParent")
  stockLots         StockLot[]
  transfersFrom     StockTransfer[]            @relation("TransferFrom")
  transfersTo       StockTransfer[]            @relation("TransferTo")
  receipts          GoodsReceipt[]
  stockCounts       StockCount[]
  purchaseRequests  PurchaseRequest[]          @relation("PRDelivery")
  purchaseOrders    PurchaseOrder[]            @relation("PODelivery")
  transitStops      PurchaseOrderTransitStop[]
  cashierSales      CashierSale[]
  nonStockItemsHere PurchaseItem[]             @relation("PurchaseItemCurrentLocation")

  @@index([type])
  @@index([yachtId])
  @@index([parentId])
}

model CashierSale {
  id                  String    @id @default(cuid())
  yachtId             String
  locationId          String
  bookingId           String?
  guestId             String?
  guestName           String?
  // Staff buyer / complimentary attribution — set when the buyer is a crew/staff
  // member, or when payMethod is "Complimentary" and a staff member is recorded
  // as the one who gave the item away (with complimentaryReason explaining why).
  employeeId          String?
  employeeName        String?
  complimentaryReason String?
  status              String    @default("open") // open | closed
  payMethod           String?
  total               Float     @default(0)
  // Discount applied at settle time — total (above) stays the raw item subtotal, unchanged
  // meaning, so every existing read of it stays correct. The amount actually charged is
  // total - discountAmount, computed wherever it's displayed.
  discountId          String?
  discountName        String?
  discountAmount      Float     @default(0)
  openedBy            String?
  closedAt            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  yacht    Yacht             @relation(fields: [yachtId], references: [id])
  location StockLocation     @relation(fields: [locationId], references: [id])
  booking  Booking?          @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  guest    BookingGuest?     @relation(fields: [guestId], references: [id], onDelete: SetNull)
  employee Employee?         @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  discount PosDiscount?      @relation(fields: [discountId], references: [id], onDelete: SetNull)
  items    CashierSaleItem[]

  @@index([yachtId])
  @@index([bookingId])
  @@index([employeeId])
  @@index([status])
  @@index([createdAt])
}

model CashierSaleItem {
  id        String   @id @default(cuid())
  saleId    String
  itemId    String?
  // Set instead of itemId when this line is a package sale — a package isn't a single
  // PurchaseItem, so it never triggers stock movement (see applyItemsToSale, which already
  // skips stock logic whenever itemId is null).
  packageId String?
  name      String
  unit      String
  price     Float
  qty       Float
  round     Int      @default(1)
  createdAt DateTime @default(now())

  sale    CashierSale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  item    PurchaseItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  package PosPackage?   @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([itemId])
  @@index([packageId])
}

// ─── POS (Point of Sale) ────────────────────────────────────────────────────
// Back-office configuration for the Cashier tablet app (src/app/cashier): what's
// on the menu, at what price, per yacht or Global (all yachts), plus packages and
// discounts sellable/applicable from that same app. A yacht-specific PosMenuItem /
// PosPackage / PosDiscount (yachtId set) overrides a Global one (yachtId null) for
// the same item — enforced in the API, not a DB constraint, since Postgres treats
// multiple NULLs in a unique index as distinct rather than colliding.

model PosCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menuItems PosMenuItem[]
  packages  PosPackage[]
}

model PosMenuItem {
  id         String   @id @default(cuid())
  itemId     String
  categoryId String
  yachtId    String?
  price      Float
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  item     PurchaseItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  category PosCategory  @relation(fields: [categoryId], references: [id])
  yacht    Yacht?       @relation(fields: [yachtId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([yachtId])
  @@index([categoryId])
}

model PosPackage {
  id          String   @id @default(cuid())
  name        String
  description String?
  categoryId  String
  yachtId     String?
  price       Float
  imageKey    String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category  PosCategory       @relation(fields: [categoryId], references: [id])
  yacht     Yacht?            @relation(fields: [yachtId], references: [id], onDelete: Cascade)
  items     PosPackageItem[]
  saleItems CashierSaleItem[]

  @@index([yachtId])
  @@index([categoryId])
}

// Informational "what's included" for a package — never deducts stock, mirroring
// the Cashier app today, which doesn't deduct stock for plain item sales either
// (applyItemsToSale only logs a StockMovement/InventoryException, see src/lib/cashier.ts).
model PosPackageItem {
  id        String @id @default(cuid())
  packageId String
  itemId    String
  qty       Float  @default(1)

  package PosPackage   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  item    PurchaseItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@index([itemId])
}

model PosDiscount {
  id        String    @id @default(cuid())
  name      String
  type      String // PERCENT | FIXED
  value     Float
  yachtId   String?
  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  yacht        Yacht?        @relation(fields: [yachtId], references: [id], onDelete: Cascade)
  cashierSales CashierSale[]

  @@index([yachtId])
}

model StockLot {
  id          String    @id @default(cuid())
  itemId      String?
  // Fallback label for PO items not linked to the PurchaseItem catalog (e.g.
  // one-off purchases like "Grab" or event flowers) — set only when itemId is null.
  itemName    String?
  unit        String?
  // Which PO this lot was received against — only ever set for non-catalog
  // ("non-stock") lots. Unlike catalog lots (which merge into one running
  // balance per item+location, since stock is fungible), each receipt of a
  // non-catalog item creates its OWN lot instead of merging into a prior one,
  // so it stays individually traceable to the PO/date/cost that brought it in.
  sourcePoId  String?
  locationId  String
  quantity    Float     @default(0)
  costPerUnit Float     @default(0)
  batch       String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  item     PurchaseItem?  @relation(fields: [itemId], references: [id])
  location StockLocation  @relation(fields: [locationId], references: [id])
  sourcePo PurchaseOrder? @relation(fields: [sourcePoId], references: [id], onDelete: SetNull)

  @@index([itemId, locationId])
  @@index([itemName, locationId])
  @@index([sourcePoId])
  @@index([expiresAt])
}

model StockMovement {
  id             String   @id @default(cuid())
  itemId         String?
  // Fallback label for non-catalog PO items — see StockLot.itemName.
  itemName       String?
  fromLocationId String?
  toLocationId   String?
  quantity       Float
  type           String
  referenceId    String?
  referenceType  String?
  notes          String?
  createdById    String
  createdAt      DateTime @default(now())

  item      PurchaseItem? @relation(fields: [itemId], references: [id])
  createdBy User          @relation(fields: [createdById], references: [id])

  @@index([itemId])
  @@index([itemName])
  @@index([type])
  @@index([createdAt])
  @@index([referenceId])
}

model PurchaseRequest {
  id                    String                   @id @default(cuid())
  prNumber              String                   @unique
  requestedById         String
  requestedByEmployeeId String?
  approverEmployeeId    String?
  deliveryLocationId    String?
  notes                 String?
  status                PurchaseRequestStatus    @default(DRAFT)
  // What this request is for — general restocking, or a specific upcoming trip. Trip
  // requests link to the actual Booking so Purchasing knows which charter/departure the
  // items need to be ready for.
  purpose               PurchaseRequestPurpose   @default(STOCK_INVENTORY)
  tripBookingId         String?
  pdfKey                String?
  // Which Purchasing staffer's queue this belongs to — see PurchaseRequestDivision.
  // Set on the public /request-order form; null for internally-created PRs, which stay
  // visible to every Purchasing user regardless of their own assigned division.
  division              PurchaseRequestDivision?
  // Set by the requester on the public /request-order intake form — lets Purchasing
  // triage at a glance instead of discovering urgency buried in free-text notes.
  neededByDate          DateTime?
  isUrgent              Boolean                  @default(false)
  urgentReason          String?
  // One {action}At/{action}ById pair per status transition — lets KPI reporting
  // compute response time between any two steps (e.g. same-day verification, or
  // draft-to-PO turnaround) without re-deriving it from an activity log.
  approvedById          String?
  approvedAt            DateTime?
  verifiedById          String?
  verifiedAt            DateTime?
  convertedById         String?
  convertedAt           DateTime?
  rejectedById          String?
  rejectedAt            DateTime?
  cancelledById         String?
  cancelledAt           DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  requestedBy         User                  @relation("PRRequestedBy", fields: [requestedById], references: [id])
  requestedByEmployee Employee?             @relation(fields: [requestedByEmployeeId], references: [id], onDelete: SetNull)
  approverEmployee    Employee?             @relation("PRApproverEmployee", fields: [approverEmployeeId], references: [id], onDelete: SetNull)
  deliveryLocation    StockLocation?        @relation("PRDelivery", fields: [deliveryLocationId], references: [id], onDelete: SetNull)
  tripBooking         Booking?              @relation(fields: [tripBookingId], references: [id], onDelete: SetNull)
  approvedBy          User?                 @relation("PRApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  verifiedBy          User?                 @relation("PRVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  convertedBy         User?                 @relation("PRConvertedBy", fields: [convertedById], references: [id], onDelete: SetNull)
  rejectedBy          User?                 @relation("PRRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  cancelledBy         User?                 @relation("PRCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  items               PurchaseRequestItem[]
  orders              PurchaseOrder[]
  transfers           StockTransfer[]
  notifications       Notification[]

  @@index([status])
  @@index([createdAt])
  @@index([requestedById])
  @@index([requestedByEmployeeId])
  @@index([approverEmployeeId])
  @@index([deliveryLocationId])
  @@index([convertedById])
  @@index([rejectedById])
  @@index([cancelledById])
  @@index([verifiedById])
  @@index([approvedById])
  @@index([tripBookingId])
  @@index([division])
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  locations Json     @default("[]")
  contact   String?
  phone     String?
  email     String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders       PurchaseOrder[]
  requestItems PurchaseRequestItem[]
  quotations   PurchaseQuotation[]
}

// Saved bank accounts for PO reimbursements — lets Purchasing/Admin pick a
// previously-used account instead of retyping bank details every time.
model ReimburseAccount {
  id                String   @id @default(cuid())
  accountHolderName String
  bankName          String
  accountNumber     String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([accountHolderName])
}

model PurchaseRequestItem {
  id                     String  @id @default(cuid())
  requestId              String
  itemId                 String?
  itemName               String
  quantity               Float
  unit                   String
  estimatedCost          Float   @default(0)
  supplierId             String?
  supplierName           String?
  notes                  String?
  imageKeys              Json    @default("[]") // reference photos for custom requests — array of base64/URL strings
  // Custom (non-catalog) requests only — catalog items are always stock-tracked via their
  // PurchaseItem record, so this only matters when itemId is null. Purely a classification
  // for now: it does not yet change Goods Receipt / StockLot behavior.
  isStockItem            Boolean @default(true)
  // Sourcing-evidence tracking for KPI 5 (compliance/quotation rules). exemptionReason:
  // catalogue-price/recurring-agreement exception per the Purchasing Approval Matrix
  // footnote. selectionJustification: expected whenever the chosen supplier isn't the
  // cheapest quotation on file.
  exemptionReason        String?
  selectionJustification String?

  // Supplier-selection approval (Purchasing Approval Matrix, band B+) — the item's
  // gathered quotations must be approved by the submitting Purchasing staffer's manager
  // before the PR can convert to a PO. quotationApproverId is resolved and fixed at
  // submission time (not re-derived later, so a later org-chart change doesn't retarget
  // an approval already in flight). Cleared back to null (along with submittedAt) by
  // src/lib/purchasing/quotationApproval.ts whenever the underlying decision changes
  // (supplier, price, or the quotation list itself) after being submitted/approved, so
  // an approval can never silently cover a since-changed decision.
  quotationSubmittedById   String?
  quotationApproverId      String?
  quotationSubmittedAt     DateTime?
  quotationApprovedById    String?
  quotationApprovedAt      DateTime?
  quotationRejectedById    String?
  quotationRejectedAt      DateTime?
  quotationRejectionReason String?

  // Set once this item has actually been swept into a PurchaseOrder or StockTransfer by
  // the convert action. Lets conversion run in multiple passes as items clear quotation
  // approval at different times — an item already converted is never re-processed, and a
  // PurchaseRequest only reaches CONVERTED once every item has this set.
  convertedAt   DateTime?
  // Which PO this item actually landed in when converted — a PR can convert in several
  // passes / across several supplier groups, so this is the only way to know which of a
  // PR's several POs a given item belongs to (used to group/label items in the PR item list).
  // Null for items fulfilled via Transfer instead of a PO.
  convertedPoId String?

  // Per-item accept/reject decision made while triaging a submitted PR — lets Purchasing
  // carry only some items forward (into ON_PROCESS / eventually a PO) instead of the
  // whole PR being an all-or-nothing Verify/Reject. Unset (null) means the item is still
  // accepted-by-default, same as before this field existed. Settable while the request is
  // DRAFT (pre-verify triage) or ON_PROCESS (Purchasing changes their mind later), but
  // never once convertedAt is set — see PATCH /api/purchasing/requests/[id]/items/[itemId].
  verifyRejectedById    String?
  verifyRejectedAt      DateTime?
  verifyRejectionReason String?

  request              PurchaseRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  item                 PurchaseItem?       @relation(fields: [itemId], references: [id], onDelete: SetNull)
  supplier             Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  convertedPo          PurchaseOrder?      @relation("PRItemConvertedPo", fields: [convertedPoId], references: [id], onDelete: SetNull)
  quotations           PurchaseQuotation[]
  quotationSubmittedBy User?               @relation("PRItemQuotationSubmittedBy", fields: [quotationSubmittedById], references: [id], onDelete: SetNull)
  quotationApprover    User?               @relation("PRItemQuotationApprover", fields: [quotationApproverId], references: [id], onDelete: SetNull)
  quotationApprovedBy  User?               @relation("PRItemQuotationApprovedBy", fields: [quotationApprovedById], references: [id], onDelete: SetNull)
  quotationRejectedBy  User?               @relation("PRItemQuotationRejectedBy", fields: [quotationRejectedById], references: [id], onDelete: SetNull)
  verifyRejectedBy     User?               @relation("PRItemVerifyRejectedBy", fields: [verifyRejectedById], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@index([quotationApproverId])
  @@index([verifyRejectedById])
  @@index([convertedPoId])
}

// Sourcing evidence for KPI 5 — one row per quotation gathered for a PR item, before the
// final supplier is chosen. Attached to PurchaseRequestItem (not PurchaseOrderItem) since
// supplier selection happens at the PR stage — a PO is already committed to one supplier.
model PurchaseQuotation {
  id            String   @id @default(cuid())
  requestItemId String
  supplierId    String?
  supplierName  String
  price         Float
  fileKey       String?
  submittedAt   DateTime @default(now())
  createdById   String
  createdAt     DateTime @default(now())

  requestItem PurchaseRequestItem @relation(fields: [requestItemId], references: [id], onDelete: Cascade)
  supplier    Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdBy   User                @relation(fields: [createdById], references: [id])

  @@index([requestItemId])
}

model PurchaseOrder {
  id                 String              @id @default(cuid())
  poNumber           String              @unique
  requestId          String?
  supplierId         String?
  supplierName       String?
  deliveryLocationId String?
  // Which trip/booking this PO's goods are for — optional (a lot of purchasing is
  // general stock, not tied to one trip), set at creation, editable same as everything else.
  bookingId          String?
  status             PurchaseOrderStatus @default(ORDERED)
  dispatchPhotoKey   String?
  dispatchedAt       DateTime?
  dispatchedByName   String?
  confirmedByName    String?
  notes              String?
  orderedAt          DateTime            @default(now())
  expectedAt         DateTime?
  cancelledAt        DateTime?
  cancelledByName    String?
  cancellationReason String?
  createdById        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  // No-login link crew on a yacht can open to confirm receiving this PO's goods, without
  // needing an ERP account — see src/app/po-receive/[token]/page.tsx and
  // src/app/api/po-receive/[token]/route.ts. Mirrors StockTransfer.receiveToken exactly.
  receiveToken          String?   @unique
  receiveTokenExpiresAt DateTime?

  // Additional pricing lines beyond item subtotal (tax/VAT, fees, etc.) — [{ label, amount }].
  // Set once at PO creation, shown above Order Total; not editable afterward, same as items.
  extraCharges Json?

  // Discount applied to the item subtotal BEFORE extraCharges are added on top.
  // discountType 'PERCENT' means discountValue is a % of the item subtotal; 'FIXED' means a flat Rupiah amount.
  discountType  String?
  discountValue Float   @default(0)

  // Requester snapshot — captured at PO creation time (direct create, or auto-created from an
  // approved PR) so department/office/role stay historically accurate even if the employee's
  // record changes later.
  requestedByEmployeeId String?
  requestedByName       String?
  requestedByOffice     String?
  requestedByDepartment String?
  requestedByRole       String?

  request               PurchaseRequest?           @relation(fields: [requestId], references: [id], onDelete: SetNull)
  supplier              Supplier?                  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  deliveryLocation      StockLocation?             @relation("PODelivery", fields: [deliveryLocationId], references: [id], onDelete: SetNull)
  createdBy             User?                      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  requestedByEmployee   Employee?                  @relation(fields: [requestedByEmployeeId], references: [id], onDelete: SetNull)
  booking               Booking?                   @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  items                 PurchaseOrderItem[]
  receipts              GoodsReceipt[]
  notifications         Notification[]
  paymentRequests       POPaymentRequest[]
  reimbursements        POReimbursement[]
  deliveryFees          DeliveryFee[]
  stockLots             StockLot[]
  transitStops          PurchaseOrderTransitStop[]
  transitTransfers      StockTransfer[]
  followUps             PurchaseFollowUp[]
  convertedRequestItems PurchaseRequestItem[]      @relation("PRItemConvertedPo")

  @@index([createdById])
  @@index([status])
  @@index([createdAt])
  @@index([requestId])
  @@index([deliveryLocationId])
  @@index([requestedByEmployeeId])
  @@index([bookingId])
}

// KPI 3 (follow-up & early escalation) — append-only-in-spirit log of chasing/escalation
// notes on a PO, primarily used once it's past its expectedAt. Deletable (not truly
// immutable) to allow correcting a mis-logged entry, per explicit user decision.
model PurchaseFollowUp {
  id            String   @id @default(cuid())
  orderId       String
  note          String
  isEscalation  Boolean  @default(false)
  escalatedToId String?
  createdById   String
  createdAt     DateTime @default(now())

  order       PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  escalatedTo User?         @relation("POFollowUpEscalatedTo", fields: [escalatedToId], references: [id], onDelete: SetNull)
  createdBy   User          @relation("POFollowUpCreatedBy", fields: [createdById], references: [id])

  @@index([orderId])
  @@index([createdAt])
}

enum POPaymentRequestStatus {
  PENDING
  PAID
}

model POPaymentRequest {
  id                String                 @id @default(cuid())
  orderId           String
  requestedById     String
  amount            Float
  notePhotoKeys     String[]               @default([])
  notes             String?
  notaDate          DateTime?
  status            POPaymentRequestStatus @default(PENDING)
  paymentMethod     String                 @default("TRANSFER")
  paidAt            DateTime?
  paidById          String?
  transferProofKeys String[]               @default([])
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  order       PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedBy User          @relation("POPaymentRequestedBy", fields: [requestedById], references: [id])
  paidBy      User?         @relation("POPaymentPaidBy", fields: [paidById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
  @@index([requestedById])
}

enum POReimbursementStatus {
  PENDING
  PAID
}

model POReimbursement {
  id                String                @id @default(cuid())
  orderId           String
  requestedById     String
  amount            Float
  notePhotoKeys     String[]              @default([])
  notes             String?
  notaDate          DateTime?
  requesterName     String
  bankName          String
  accountNumber     String
  accountHolderName String
  status            POReimbursementStatus @default(PENDING)
  paidAt            DateTime?
  paidById          String?
  transferProofKeys String[]              @default([])
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  order       PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedBy User          @relation("POReimbursementRequestedBy", fields: [requestedById], references: [id])
  paidBy      User?         @relation("POReimbursementPaidBy", fields: [paidById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
  @@index([requestedById])
}

// A delivery/shipping fee, usually tied to an existing PO ("which PO's goods this
// shipment cost covers") but not required to be — a shipment can consolidate
// several POs or be a standalone cargo delivery with no single PO behind it.
// No items of its own. Goes through the same Request Payment / Debit Paid /
// Reimburse flow as a Purchase Order.
model DeliveryFee {
  id              String   @id @default(cuid())
  feeNumber       String   @unique
  purchaseOrderId String?
  notes           String?
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseOrder   PurchaseOrder?              @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  createdBy       User?                       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  paymentRequests DeliveryFeePaymentRequest[]
  reimbursements  DeliveryFeeReimbursement[]

  @@index([purchaseOrderId])
  @@index([createdById])
  @@index([createdAt])
}

enum DeliveryFeePaymentRequestStatus {
  PENDING
  PAID
}

model DeliveryFeePaymentRequest {
  id                String                          @id @default(cuid())
  deliveryFeeId     String
  requestedById     String
  amount            Float
  notePhotoKeys     String[]                        @default([])
  notes             String?
  notaDate          DateTime?
  status            DeliveryFeePaymentRequestStatus @default(PENDING)
  paymentMethod     String                          @default("TRANSFER")
  paidAt            DateTime?
  paidById          String?
  transferProofKeys String[]                        @default([])
  createdAt         DateTime                        @default(now())
  updatedAt         DateTime                        @updatedAt

  deliveryFee DeliveryFee @relation(fields: [deliveryFeeId], references: [id], onDelete: Cascade)
  requestedBy User        @relation("DeliveryFeePaymentRequestedBy", fields: [requestedById], references: [id])
  paidBy      User?       @relation("DeliveryFeePaymentPaidBy", fields: [paidById], references: [id], onDelete: SetNull)

  @@index([deliveryFeeId])
  @@index([status])
  @@index([requestedById])
}

enum DeliveryFeeReimbursementStatus {
  PENDING
  PAID
}

model DeliveryFeeReimbursement {
  id                String                         @id @default(cuid())
  deliveryFeeId     String
  requestedById     String
  amount            Float
  notePhotoKeys     String[]                       @default([])
  notes             String?
  notaDate          DateTime?
  requesterName     String
  bankName          String
  accountNumber     String
  accountHolderName String
  status            DeliveryFeeReimbursementStatus @default(PENDING)
  paidAt            DateTime?
  paidById          String?
  transferProofKeys String[]                       @default([])
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt

  deliveryFee DeliveryFee @relation(fields: [deliveryFeeId], references: [id], onDelete: Cascade)
  requestedBy User        @relation("DeliveryFeeReimbursementRequestedBy", fields: [requestedById], references: [id])
  paidBy      User?       @relation("DeliveryFeeReimbursementPaidBy", fields: [paidById], references: [id], onDelete: SetNull)

  @@index([deliveryFeeId])
  @@index([status])
  @@index([requestedById])
}

model PurchaseOrderItem {
  id          String  @id @default(cuid())
  orderId     String
  itemId      String?
  itemName    String
  unit        String?
  orderedQty  Float
  receivedQty Float   @default(0)
  unitCost    Float   @default(0)

  order PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item  PurchaseItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model GoodsReceipt {
  id                   String   @id @default(cuid())
  grNumber             String   @unique
  orderId              String
  // Exactly one of receivedById/receivedByEmployeeId is set in practice: the internal,
  // logged-in staff flow sets receivedById; the no-login PO-receive link (crew on a yacht,
  // see src/app/po-receive/[token]) sets receivedByEmployeeId instead, since there's no
  // User session to attribute it to. Both nullable/SetNull, same pattern as
  // StockTransfer.receivedById.
  receivedById         String?
  receivedByEmployeeId String?
  receiverName         String?
  locationId           String
  receivePhotoKey      String?
  notes                String?
  receivedAt           DateTime @default(now())
  createdAt            DateTime @default(now())

  order              PurchaseOrder      @relation(fields: [orderId], references: [id])
  receivedBy         User?              @relation(fields: [receivedById], references: [id], onDelete: SetNull)
  receivedByEmployee Employee?          @relation(fields: [receivedByEmployeeId], references: [id], onDelete: SetNull)
  location           StockLocation      @relation(fields: [locationId], references: [id])
  items              GoodsReceiptItem[]
  transitTransfers   StockTransfer[]

  @@index([orderId])
  @@index([receivedAt])
}

model GoodsReceiptItem {
  id          String    @id @default(cuid())
  receiptId   String
  itemId      String?
  itemName    String
  receivedQty Float
  unitCost    Float     @default(0)
  outcome     String    @default("ACCEPTED")
  condition   String    @default("good")
  batch       String?
  expiryDate  DateTime?
  notes       String?

  receipt GoodsReceipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  item    PurchaseItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([receiptId])
}

// Ordered intermediate stops for a PO's shipping route, between the supplier and
// PurchaseOrder.deliveryLocationId (the final destination, unchanged). Each hop between
// consecutive stops (and the final stop -> deliveryLocationId) is executed as a normal
// StockTransfer, auto-chained — see src/lib/purchasing/transitChain.ts.
model PurchaseOrderTransitStop {
  id         String        @id @default(cuid())
  poId       String
  order      PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  sequence   Int
  locationId String
  location   StockLocation @relation(fields: [locationId], references: [id])
  createdAt  DateTime      @default(now())

  @@unique([poId, sequence])
  @@index([poId])
}

model StockTransfer {
  id                    String         @id @default(cuid())
  transferNumber        String         @unique
  fromLocationId        String
  toLocationId          String
  crewRequestId         String?
  purchaseRequestId     String?
  // Set when this transfer is one leg of a PO's multi-stop transit route (auto-created,
  // see src/lib/purchasing/transitChain.ts). originGoodsReceiptId stays the same across every
  // leg spawned from one shipment, so partial deliveries get independent chains.
  purchaseOrderId       String?
  originGoodsReceiptId  String?
  legSequence           Int?
  status                TransferStatus @default(PENDING)
  dispatchPhotoKey      String?
  receivePhotoKey       String?
  dispatchedById        String?
  receivedById          String?
  expectedReceiverId    String?
  expectedReceiverName  String?
  receivedByName        String?
  notes                 String?
  dispatchedAt          DateTime?
  receivedAt            DateTime?
  // No-login crew confirmation link — see src/app/crew-receive/[token]/page.tsx and
  // src/app/api/crew-receive/[token]/route.ts. Mirrors Customer.guestFormToken.
  receiveToken          String?        @unique
  receiveTokenExpiresAt DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  fromLocation       StockLocation       @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocation         StockLocation       @relation("TransferTo", fields: [toLocationId], references: [id])
  crewRequest        CrewRequest?        @relation(fields: [crewRequestId], references: [id], onDelete: SetNull)
  purchaseRequest    PurchaseRequest?    @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull)
  purchaseOrder      PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  originGoodsReceipt GoodsReceipt?       @relation(fields: [originGoodsReceiptId], references: [id], onDelete: SetNull)
  dispatchedBy       User?               @relation("TransferDispatch", fields: [dispatchedById], references: [id], onDelete: SetNull)
  receivedBy         User?               @relation("TransferReceive", fields: [receivedById], references: [id], onDelete: SetNull)
  expectedReceivedBy User?               @relation("TransferExpectedReceive", fields: [expectedReceiverId], references: [id], onDelete: SetNull)
  items              StockTransferItem[]

  @@index([status])
  @@index([createdAt])
  @@index([crewRequestId])
  @@index([purchaseRequestId])
  @@index([purchaseOrderId])
  @@index([originGoodsReceiptId])
}

model StockTransferItem {
  id            String  @id @default(cuid())
  transferId    String
  itemId        String?
  itemName      String
  requestedQty  Float
  dispatchedQty Float   @default(0)
  receivedQty   Float   @default(0)

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  item     PurchaseItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([transferId])
}

model StockCount {
  id           String           @id @default(cuid())
  countNumber  String           @unique
  locationId   String
  status       StockCountStatus @default(DRAFT)
  notes        String?
  photoKey     String?
  countedById  String
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  location   StockLocation    @relation(fields: [locationId], references: [id])
  countedBy  User             @relation("StockCountBy", fields: [countedById], references: [id])
  approvedBy User?            @relation("StockCountApprove", fields: [approvedById], references: [id], onDelete: SetNull)
  items      StockCountItem[]

  @@index([status])
  @@index([locationId])
  @@index([createdAt])
}

model StockCountItem {
  id         String  @id @default(cuid())
  countId    String
  itemId     String?
  itemName   String
  systemQty  Float
  countedQty Float   @default(0)
  reason     String?

  count StockCount    @relation(fields: [countId], references: [id], onDelete: Cascade)
  item  PurchaseItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([countId])
}

model CrewRequest {
  id            String            @id @default(cuid())
  yachtId       String
  requestedById String
  status        CrewRequestStatus @default(PENDING)
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  yacht       Yacht             @relation(fields: [yachtId], references: [id])
  requestedBy User              @relation(fields: [requestedById], references: [id])
  items       CrewRequestItem[]
  transfers   StockTransfer[]

  @@index([yachtId, status])
  @@index([status])
  @@index([createdAt])
}

model CrewRequestItem {
  id        String  @id @default(cuid())
  requestId String
  itemId    String?
  itemName  String
  quantity  Float
  unit      String
  notes     String?

  request CrewRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  item    PurchaseItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([requestId])
}

model InventoryException {
  id            String    @id @default(cuid())
  type          String // TRANSFER_DISCREPANCY | NEGATIVE_STOCK | RECEIVING_DISCREPANCY | STOCK_COUNT_VARIANCE
  itemId        String?
  itemName      String
  locationId    String?
  locationName  String
  qty           Float     @default(0)
  value         Float     @default(0)
  reason        String?
  referenceId   String?
  referenceType String?
  status        String    @default("OPEN")
  resolution    String?
  resolvedAt    DateTime?
  resolvedById  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  resolvedBy User? @relation("ExceptionResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([referenceId])
}

// ─── People & HR (minimal master data) ─────────────────────────────────────────

model LegalEntity {
  id        String   @id @default(cuid())
  name      String
  code      String?  @unique
  country   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  employees Employee[]
  documents LegalDocument[]
}

// One row per tracked legal/compliance document, grouped into free-text `section`s
// ("Company Legal", "Boat / Vessel Documents", …) purely for display. Owned by exactly
// one of `legalEntity` (company-level: NIB, licenses, …) or `yacht` (per-vessel papers:
// Certificate of Registry, Safety Equipment Certificate, …) — never both, never neither;
// enforced in the API, not the DB, same as every other exactly-one-parent shape in this
// schema. `period` is descriptive only (shown as typed — "3 Months", "Permanent", …);
// `expiryDate` is the one field renewal reminders actually key off, since not every
// document's real expiry cleanly follows establishDate + period (insurance/trademark
// renewals, for instance, often don't).
model LegalDocument {
  id            String       @id @default(cuid())
  legalEntityId String?
  legalEntity   LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  yachtId       String?
  yacht         Yacht?       @relation(fields: [yachtId], references: [id], onDelete: Cascade)
  section       String?
  name          String
  category      String?
  period        String?
  subDetail     String?
  fileKey       String?
  establishDate DateTime?
  expiryDate    DateTime?
  issuer        String?
  vendor        String?
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  notifications Notification[]

  @@index([legalEntityId])
  @@index([yachtId])
  @@index([expiryDate])
}

// Which brand/operation an employee's work is attributed to (Samara 1, Samara 2,
// Mischief, Otium, BayView Hotel, Resort, …) — distinct from LegalEntity (who
// legally employs them) and from EmployeeWorkLocation (where they're based).
// A charter crew member's legal entity, work location, and business unit can all
// differ from one another, so each is tracked separately rather than derived.
model BusinessUnit {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  employees Employee[]
}

// HR's own "where is this person based" taxonomy (Bali / Bajo / Kapal / Hotel) —
// deliberately separate from StockLocation, which models warehouse/vessel storage
// areas (down to sub-locations like a vessel's Bar or Galley) for the purchasing
// module. Reusing StockLocation for HR would surface irrelevant storage-only rows
// (e.g. "Waste / Quarantine") as if they were places an employee could work.
model EmployeeWorkLocation {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  employees Employee[]
  roles     EmployeeRole[]
}

model EmployeeRole {
  id        String   @id @default(cuid())
  title     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // Optional — which work location this role is scoped to (e.g. "Bartender" specific
  // to a vessel). Null means the role applies generically across locations.
  locationId String?
  location   EmployeeWorkLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  employees         Employee[]
  candidates        Candidate[]
  compensationBands CompensationBand[]

  @@index([title])
  @@index([locationId])
}

enum CompensationLevel {
  HIGH
  MEDIUM
  LOW
}

// One row per (role, level) — the approved salary range a role/skill-tier combination
// should pay. Employee.level marks which tier an individual sits at; comparing their
// actual basicSalary against this band's min/max is how "position vs. approved range"
// gets computed (done in the UI/API, not stored).
model CompensationBand {
  id        String            @id @default(cuid())
  roleId    String
  role      EmployeeRole      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  level     CompensationLevel
  minSalary Float
  maxSalary Float
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([roleId, level])
}

model Employee {
  id                     String             @id @default(cuid())
  employeeNumber         String             @unique
  fullName               String
  department             String?
  gender                 String?
  employmentStatus       String? // e.g. Permanent | Contract | Probation | Intern
  // Skill/experience tier within their EmployeeRole — the compensation band (see
  // CompensationBand) this employee's actual basicSalary gets compared against.
  level                  CompensationLevel?
  leaveBalance           Int?
  // Which entitlement policy this person's leaveBalance accrues under — kept as free
  // text (like employmentStatus/department) rather than a numeric "days" column since
  // real policies mix units (e.g. crew get a lump "2 bulan" block, not a daily count).
  leaveEntitlementPolicy String?
  joinDate               DateTime?
  // Only meaningful for fixed-term employment (Probation/Internship/Freelance/PKWT) —
  // Permanent (PKWTT) staff typically leave contractEndDate null. Powers "contracts
  // expiring soon" reporting once that's built.
  contractStartDate      DateTime?
  contractEndDate        DateTime?
  phone                  String?
  address                String?
  birthDate              DateTime?

  // Contact Info — extended personal data
  nikPassport              String? // NIK (national ID) or Passport number
  nationality              String?
  religion                 String?
  placeOfBirth             String?
  motherName               String?
  personalEmail            String?
  maritalStatus            String? // PTKP: TK | K0 | K1 | K2 | K3
  addressCurrent           String? // Address 2 — current address, if different from ID
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  // Legal / Tax
  npwp     String?
  kkNumber String? // Kartu Keluarga (family card) number

  // Bank
  bankName          String?
  bankAccountNumber String?
  bankAccountName   String?

  // BPJS
  bpjsKesehatanNumber String?
  bpjsTkNumber        String?

  // Compensation
  basicSalary Float?
  allowance   Float?
  // Base daily rate. For shore-based staff (work location doesn't match a Yacht name)
  // this is paid flat each period. For crew stationed on a yacht (location name matches
  // a Yacht.name), Payroll multiplies this by the number of days that yacht had a trip
  // within the payroll period — see countTripDaysInPeriod in src/lib/payroll.ts.
  uangLayar   Float?
  uangMakan   Float?
  // THR (Tunjangan Hari Raya) — pre-fills PayslipEntry.thr at generation time, still
  // manually overridable per period like every other payroll figure.
  thr         Float?
  // Recurring named income lines beyond the fixed columns above (e.g. a fixed monthly
  // allowance HR wants itemized on the payslip) — array of { id, name, description, amount }.
  // Snapshotted onto PayslipEntry.otherIncomeSnap at generation time.
  otherIncome Json    @default("[]")

  // Documents — each stored as data-URL strings, same pattern as PurchaseQuotation.fileKey
  seamanBookFiles     String[] @default([]) // Buku Pelaut
  bstFiles            String[] @default([]) // Basic Safety Training certificate
  medicalCheckupFiles String[] @default([])
  ijazahFiles         String[] @default([])
  certificateFiles    String[] @default([])
  // Employment contract document(s) — expiry is contractEndDate above, already surfaced
  // on the HR Overview "Contracts Expiring Soon" widget.
  contractFiles       String[] @default([])

  isActive     Boolean   @default(true)
  resignedAt   DateTime?
  resignStatus String? // RESIGNED | TERMINATED | CONTRACT_ENDED | OTHER
  resignReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  legalEntityId String?
  legalEntity   LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)

  businessUnitId String?
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)

  locationId String?
  location   EmployeeWorkLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  roleId String?
  role   EmployeeRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  // Company org chart / reporting line — who this employee reports to. Drives
  // approval routing (Purchasing bands, and eventually HR leave/permit requests)
  // without hardcoding a fixed approver: the system just walks this chain.
  managerId     String?
  manager       Employee?  @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports Employee[] @relation("EmployeeManager")

  // Links this Employee record to their login account — lets the system resolve
  // "who is logged in" to an org-chart position, and resolve a manager's Employee
  // row back to the User account that should see/approve the request.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  candidateSource Candidate?

  purchaseRequests          PurchaseRequest[]
  purchaseRequestsToApprove PurchaseRequest[]  @relation("PRApproverEmployee")
  purchaseOrdersRequested   PurchaseOrder[]
  goodsReceipts             GoodsReceipt[]
  cashierSales              CashierSale[]
  leaveRequests             LeaveRequest[]
  probationReviews          ProbationReview[]
  payslipEntries            PayslipEntry[]
  attendanceRecords         AttendanceRecord[]
  loanRequests              LoanRequest[]
  loanInstallments          LoanInstallment[]

  @@index([legalEntityId])
  @@index([businessUnitId])
  @@index([locationId])
  @@index([roleId])
  @@index([fullName])
  @@index([managerId])
}

enum ProbationStage {
  REQUESTED // manager (or HR on their behalf) submitted the review
  HR_REVIEW // sitting with HR
  MANAGEMENT_APPROVAL // HR passed it, sitting with Management
  APPROVED // fully approved — hiring confirmed, HR now works the checklist below
  REJECTED // stopped at either HR or Management review
}

// Requested by Manager → reviewed by HR → approved by Management → Hiring. Once
// APPROVED, HR works through contractProcessedAt/pklProcessedAt/bpjs*RegisteredAt as a
// checklist (PKL = Perjanjian Kerja Laut, the seafarer's employment agreement — only
// meaningful for crew, but harmless to leave unchecked for office staff).
model ProbationReview {
  id         String         @id @default(cuid())
  employeeId String
  employee   Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  stage      ProbationStage @default(REQUESTED)

  requestedById String
  requestedBy   User     @relation("ProbationRequestedBy", fields: [requestedById], references: [id])
  requestedAt   DateTime @default(now())
  requestNote   String?

  hrDecidedById String?
  hrDecidedBy   User?     @relation("ProbationHrDecided", fields: [hrDecidedById], references: [id], onDelete: SetNull)
  hrDecidedAt   DateTime?
  hrApproved    Boolean?
  hrNote        String?

  managementDecidedById String?
  managementDecidedBy   User?     @relation("ProbationManagementDecided", fields: [managementDecidedById], references: [id], onDelete: SetNull)
  managementDecidedAt   DateTime?
  managementApproved    Boolean?
  managementNote        String?

  contractProcessedAt DateTime?
  pklProcessedAt      DateTime?
  bpjsTkRegisteredAt  DateTime?
  bpjsKesRegisteredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([stage])
}

enum PayrollPeriodStatus {
  OPEN // HR/Finance generating & editing entries
  SUBMITTED // sent for Head-of-Finance approval
  APPROVED // approved, ready to execute
  REJECTED // sent back — reopen to OPEN before resubmitting
  PAID // Finance executed payroll (bank transfer done)
}

// Cutoff on the 20th → HR/Finance fill PayslipEntry rows while OPEN → submit →
// Head-of-Finance (FINANCE_DIRECTOR/ADMIN/SUPER_ADMIN) approves/rejects → Finance
// executes payroll around the 25th and marks PAID. Actor+timestamp triplets follow
// ProbationReview's convention above.
model PayrollPeriod {
  id     String              @id @default(cuid())
  year   Int
  month  Int // 1-12
  status PayrollPeriodStatus @default(OPEN)

  cutoffDate DateTime? // the 20th
  payDate    DateTime? // the 25th
  notes      String?

  createdById   String?
  createdBy     User?     @relation("PayrollCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  submittedById String?
  submittedBy   User?     @relation("PayrollSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  submittedAt   DateTime?
  approvedById  String?
  approvedBy    User?     @relation("PayrollApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt    DateTime?
  approvalNote  String?
  rejectedById  String?
  rejectedBy    User?     @relation("PayrollRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  rejectedAt    DateTime?
  rejectionNote String?
  paidById      String?
  paidBy        User?     @relation("PayrollPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  paidAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries PayslipEntry[]

  @@unique([year, month])
  @@index([status])
}

// One row per employee per period. Every figure is a SNAPSHOT (copied at generate time,
// then editable) so a historical payslip never drifts if the Employee record changes later.
model PayslipEntry {
  id              String        @id @default(cuid())
  payrollPeriodId String
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  // Restrict, not Cascade: this is a financial record and must survive employee deletion.
  // Resigned employees are handled via Employee.isActive/resignedAt, not row deletion.

  employeeNumberSnap    String
  fullNameSnap          String
  positionSnap          String?
  companyNameSnap       String?
  npwpSnap              String?
  nikSnap               String?
  bankNameSnap          String?
  bankAccountNumberSnap String?
  bankAccountNameSnap   String?
  leaveBalanceSnap      Int?
  joinDateSnap          DateTime? // ← Employee.joinDate — payslip shows join date + tenure as of this period
  workLocationSnap      String? // ← Employee.location.name

  // Earnings
  basicSalary       Float @default(0)
  functionAllowance Float @default(0) // ← Employee.allowance
  mealAllowance     Float @default(0) // ← Employee.uangMakan
  uangLayar         Float @default(0) // ← Employee.uangLayar (rate) × uangLayarTripDays, when set
  // Number of trip days this yacht sailed within the period, when the employee's work
  // location matched a Yacht — null means uangLayar was paid flat (shore-based staff).
  // Informational snapshot only; editing uangLayar above directly doesn't update this.
  uangLayarTripDays Int?
  commission        Float @default(0) // manual only, varies per period
  thr               Float @default(0) // ← Employee.thr at generation time, still manually overridable
  // Snapshot of Employee.otherIncome at generation time — array of { id, name, description, amount }.
  otherIncomeSnap   Json  @default("[]")
  otherIncomeTotal  Float @default(0) // = sum of otherIncomeSnap amounts, folded into grossEarnings

  bpjsJkkCompany       Float @default(0)
  bpjsJkmCompany       Float @default(0)
  bpjsJhtCompany       Float @default(0)
  bpjsJpCompany        Float @default(0)
  bpjsKesehatanCompany Float @default(0)

  // Deductions
  bpjsJhtEmployee       Float            @default(0)
  bpjsJpEmployee        Float            @default(0)
  bpjsKesehatanEmployee Float            @default(0)
  pph21                 Float            @default(0)
  // Manual amount, prefilled from the linked LoanInstallment (if any) when this entry is
  // generated — see LoanInstallment.payslipEntryId and periods/[id]/route.ts.
  loanDeduction         Float            @default(0)
  loanInstallment       LoanInstallment?

  grossEarnings    Float   @default(0)
  totalDeductions  Float   @default(0)
  takeHomePay      Float   @default(0)
  isManuallyEdited Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([payrollPeriodId, employeeId])
  @@index([employeeId])
  @@index([payrollPeriodId])
}

// Singleton row (id="default") of editable BPJS rates/caps + a simplified PPh21
// bracket/PTKP table. Consumed by src/lib/payroll.ts as auto-suggestion inputs only —
// every computed figure stays overridable on PayslipEntry.
model PayrollSettings {
  id String @id @default("default")

  jkkRate         Float @default(0.0024)
  jkmRate         Float @default(0.003)
  jhtCompanyRate  Float @default(0.037)
  jhtEmployeeRate Float @default(0.02)
  jpCompanyRate   Float @default(0.02)
  jpEmployeeRate  Float @default(0.01)
  jpSalaryCap     Float @default(10547400)

  bpjsKesehatanCompanyRate  Float @default(0.04)
  bpjsKesehatanEmployeeRate Float @default(0.01)
  bpjsKesehatanSalaryCap    Float @default(12000000)

  // [{ upTo: number|null, rate: number }], last bracket's upTo=null (no ceiling)
  pph21Brackets                   Json  @default("[{\"upTo\":60000000,\"rate\":0.05},{\"upTo\":250000000,\"rate\":0.15},{\"upTo\":500000000,\"rate\":0.25},{\"upTo\":5000000000,\"rate\":0.3},{\"upTo\":null,\"rate\":0.35}]")
  // Keyed by Employee.maritalStatus (TK|K0|K1|K2|K3)
  ptkpAmounts                     Json  @default("{\"TK\":54000000,\"K0\":58500000,\"K1\":63000000,\"K2\":67500000,\"K3\":72000000}")
  positionCostDeductionRate       Float @default(0.05) // biaya jabatan
  positionCostDeductionCapMonthly Float @default(500000)

  updatedById String?
  updatedBy   User?    @relation("PayrollSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Single-step approval, same routing idea as PurchaseRequest: goes to the employee's
// manager (via Employee.managerId) if that manager has an ERP login, otherwise falls
// back to notifying HR/Admin directly so it never sits unseen. Approving debits
// Employee.leaveBalance by `days` (not enforced as a hard floor — HR can still approve
// into a negative balance, e.g. advance leave, but sees the resulting balance).
model LeaveRequest {
  id         String             @id @default(cuid())
  employeeId String
  employee   Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  startDate  DateTime
  endDate    DateTime
  days       Int
  reason     String?
  status     LeaveRequestStatus @default(PENDING)

  requestedById String
  requestedBy   User     @relation("LeaveRequestedBy", fields: [requestedById], references: [id])
  requestedAt   DateTime @default(now())

  decidedById  String?
  decidedBy    User?     @relation("LeaveDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?

  attendanceRecords AttendanceRecord[]

  @@index([employeeId])
  @@index([status])
}

enum AttendanceStatus {
  HADIR // present
  IZIN // permission / excused absence
  SAKIT // sick
  CUTI // approved leave — auto-set when a LeaveRequest is approved (see LeaveRequest.attendanceRecords)
  ALPHA // unauthorized absence
  LIBUR // scheduled day off (e.g. a public holiday falling on a weekday)
}

// A row only exists for a day HR (or an approved Leave Request) explicitly set — any
// (employee, date) with no row is implicitly HADIR. Work week is Mon–Fri (confirmed by
// the business); Sat/Sun are never stored here and never affect Payroll's meal-allowance
// calculation (see src/lib/payroll.ts's countWeekdaysInMonth).
model AttendanceRecord {
  id         String           @id @default(cuid())
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime // the calendar day, stored at midnight — no meaningful time component
  status     AttendanceStatus
  note       String?

  // Set when this row exists because a Leave Request was approved, rather than a direct
  // HR edit — lets the grid show provenance.
  leaveRequestId String?
  leaveRequest   LeaveRequest? @relation(fields: [leaveRequestId], references: [id], onDelete: SetNull)

  setById String?
  setBy   User?   @relation("AttendanceSetBy", fields: [setById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
}

// A single shared calendar of dates — not one row per employee. Attendance Recap treats
// any date found here the same way it already treats a Saturday/Sunday: LIBUR by default
// for everyone, excluded from Payroll's Meal Allowance working-days baseline, but still
// individually overridable per employee (e.g. someone who actually worked that day) via
// a normal AttendanceRecord row, which always takes precedence.
model NationalHoliday {
  id   String   @id @default(cuid())
  date DateTime @unique // the calendar day, stored at midnight
  name String

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([date])
}

enum LoanRequestStatus {
  PENDING_HR
  PENDING_FINANCE
  PENDING_SPECIAL
  APPROVED
  REJECTED
}

enum LoanInstallmentStatus {
  PENDING
  PAID
}

// HR → Finance → Special Approval, sequential — rejecting at any stage ends it. No
// Supervisor stage (dropped per the user — every loan starts at HR regardless of the
// employee's manager). "Special Approval" is role-gated (ADMIN/SUPER_ADMIN) same as
// Payroll's "Head of Finance" — no dedicated senior/owner role exists in this app.
model LoanRequest {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  amount     Float
  termMonths Int
  reason     String?
  status     LoanRequestStatus @default(PENDING_HR)

  requestedById String
  requestedBy   User     @relation("LoanRequestedBy", fields: [requestedById], references: [id])
  requestedAt   DateTime @default(now())

  // First payroll period (year/month) the schedule should start deducting from — set
  // once Special Approval finalizes it, used to generate the LoanInstallment rows below.
  firstDeductionYear  Int?
  firstDeductionMonth Int?

  hrDecidedById String?
  hrDecidedBy   User?     @relation("LoanHrDecidedBy", fields: [hrDecidedById], references: [id], onDelete: SetNull)
  hrDecidedAt   DateTime?
  hrApproved    Boolean?
  hrNote        String?

  financeDecidedById String?
  financeDecidedBy   User?     @relation("LoanFinanceDecidedBy", fields: [financeDecidedById], references: [id], onDelete: SetNull)
  financeDecidedAt   DateTime?
  financeApproved    Boolean?
  financeNote        String?

  specialDecidedById String?
  specialDecidedBy   User?     @relation("LoanSpecialDecidedBy", fields: [specialDecidedById], references: [id], onDelete: SetNull)
  specialDecidedAt   DateTime?
  specialApproved    Boolean?
  specialNote        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  installments LoanInstallment[]

  @@index([employeeId])
  @@index([status])
}

// Generated once (termMonths rows) the moment Special Approval approves. "Outstanding
// balance" and "due this payroll run" are always computed from these rows, never stored.
model LoanInstallment {
  id            String      @id @default(cuid())
  loanRequestId String
  loanRequest   LoanRequest @relation(fields: [loanRequestId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  installmentNumber Int
  dueYear           Int
  dueMonth          Int
  amount            Float
  status            LoanInstallmentStatus @default(PENDING)

  // Tentatively set when a PayrollPeriod's "Generate Entries" pulls this installment into
  // someone's loanDeduction; only flips this row to PAID once that period is actually
  // marked Paid. @unique because each installment backs at most one payslip entry — only
  // the single next-due installment per employee per period is auto-pulled; clearing an
  // arrears backlog is a manual "Mark Paid" via the installment's own PATCH route.
  payslipEntryId String?       @unique
  payslipEntry   PayslipEntry? @relation(fields: [payslipEntryId], references: [id], onDelete: SetNull)
  paidAt         DateTime?
  paidAmount     Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([loanRequestId, installmentNumber])
  @@index([employeeId])
  @@index([loanRequestId])
}

enum CandidateStatus {
  NEW
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

// Talent pool — a lightweight recruitment pipeline, not a full ATS. HIRED/REJECTED are
// terminal states excluded from the "active pipeline" count shown on HR Overview.
model Candidate {
  id            String          @id @default(cuid())
  fullName      String
  appliedRoleId String?
  appliedRole   EmployeeRole?   @relation(fields: [appliedRoleId], references: [id], onDelete: SetNull)
  phone         String?
  email         String?
  source        String?
  resumeFiles   String[]        @default([])
  expectedSalary Float?
  location      String?
  readyJoinDate DateTime?
  additionalDocuments Json      @default("[]") // named extra docs — array of { id, name, description, fileKey }
  notes         String?
  status        CandidateStatus @default(NEW)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Set once this candidate is converted into a real Employee (on probation) from
  // the Talent Pool — prevents converting the same hire twice and links back to
  // the resulting employee record.
  convertedEmployeeId String?   @unique
  convertedEmployee   Employee? @relation(fields: [convertedEmployeeId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([appliedRoleId])
}

// ─── WhatsApp Chat (admin-only inbox, Freshchat-style) ─────────────────────────
// This app doesn't talk to any WhatsApp provider directly — inbound messages land
// via POST /api/webhooks/whatsapp (whoever owns the WA API integration points its
// webhook here) and outbound sends go through src/lib/whatsapp.ts, which is a stub
// until that same integration is wired up on the sending side too.

enum WhatsappDirection {
  IN
  OUT
}

enum WhatsappMessageStatus {
  PENDING // queued locally, not yet handed to the WhatsApp API
  SENT
  DELIVERED
  READ
  FAILED
}

model WhatsappConversation {
  id                 String   @id @default(cuid())
  phone              String   @unique // whatever format the provider sends, kept as-is
  contactName        String?
  lastMessageAt      DateTime @default(now())
  lastMessagePreview String?
  unreadCount        Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  messages WhatsappMessage[]

  @@index([lastMessageAt])
}

model WhatsappMessage {
  id                String                @id @default(cuid())
  conversationId    String
  conversation      WhatsappConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction         WhatsappDirection
  body              String?
  mediaUrl          String?
  mediaType         String?
  status            WhatsappMessageStatus @default(SENT)
  // Provider's own message id — lets the inbound webhook dedupe on redelivery,
  // and lets an outbound send record what it maps to once the provider replies.
  providerMessageId String?               @unique
  sentByUserId      String?
  sentByName        String?
  createdAt         DateTime              @default(now())

  // WhatsApp-style "swipe to reply" quoting — points at another message in the
  // same conversation, either direction. SetNull so deleting the quoted message
  // (not currently exposed, but harmless if it ever is) doesn't cascade.
  replyToId String?
  replyTo   WhatsappMessage?  @relation("WhatsappMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   WhatsappMessage[] @relation("WhatsappMessageReplies")

  @@index([conversationId, createdAt])
}

// ─── Instagram DM (admin-only inbox) ───────────────────────────────────────────
// Same shape/reasoning as the WhatsApp chat above — this app doesn't talk to
// Instagram's API directly yet; inbound messages land via POST
// /api/webhooks/instagram once that integration is wired up.

enum InstagramDirection {
  IN
  OUT
}

enum InstagramMessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model InstagramConversation {
  id                 String   @id @default(cuid())
  igUsername         String   @unique
  displayName        String?
  profilePicUrl      String?
  // Which of OUR connected IG Business accounts this conversation came in on (e.g.
  // "samara.liveaboard", "mischief.voyage", "otium") — only meaningful once multiple
  // accounts are actually connected; the inbound webhook should set this from the
  // payload's entry[].id (mapped to that account's username) once that's wired up.
  ourAccountUsername String?
  lastMessageAt      DateTime @default(now())
  lastMessagePreview String?
  unreadCount        Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  messages InstagramMessage[]

  @@index([lastMessageAt])
}

model InstagramMessage {
  id                String                 @id @default(cuid())
  conversationId    String
  conversation      InstagramConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction         InstagramDirection
  body              String?
  mediaUrl          String?
  mediaType         String?
  status            InstagramMessageStatus @default(SENT)
  providerMessageId String?                @unique
  sentByUserId      String?
  sentByName        String?
  createdAt         DateTime               @default(now())

  // "Swipe to reply" quoting, same as WhatsApp's — points at another message in
  // the same conversation, either direction.
  replyToId String?
  replyTo   InstagramMessage?  @relation("InstagramMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   InstagramMessage[] @relation("InstagramMessageReplies")

  @@index([conversationId, createdAt])
}

// ─── Email inbox (admin-only, chat-shaped) ─────────────────────────────────────
// Same idea again — a normalized local inbox that any inbound-email provider
// (Postmark/SendGrid inbound parse, Resend, etc.) can be pointed at later via
// POST /api/webhooks/email-inbox.

enum EmailInboxDirection {
  IN
  OUT
}

enum EmailInboxMessageStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

model EmailInboxConversation {
  id                 String   @id @default(cuid())
  fromEmail          String   @unique
  fromName           String?
  subject            String
  lastMessageAt      DateTime @default(now())
  lastMessagePreview String?
  unreadCount        Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  messages EmailInboxMessage[]

  @@index([lastMessageAt])
}

model EmailInboxMessage {
  id                String                  @id @default(cuid())
  conversationId    String
  conversation      EmailInboxConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction         EmailInboxDirection
  body              String?
  attachmentUrls    String[]                @default([])
  status            EmailInboxMessageStatus @default(SENT)
  providerMessageId String?                 @unique
  sentByUserId      String?
  sentByName        String?
  createdAt         DateTime                @default(now())

  @@index([conversationId, createdAt])
}
