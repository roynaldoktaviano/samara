generator client {
  provider      = "prisma-client-js"
  // "native" covers whatever machine runs `prisma generate` locally (e.g. your Mac);
  // the other two cover most Ubuntu/Debian VPS's (Cloudways included) so a client
  // generated locally still runs once deployed there. Run `cat /etc/os-release` and
  // `openssl version` on the server if unsure which OpenSSL target it actually needs.
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  SALES
  FINANCE
  MARKETING
  PURCHASING
  WAREHOUSE
  HR
  SALES_MARKETING // combined role — treated as SALES for sales-gated screens, MARKETING for marketing-gated ones
  FINANCE_DIRECTOR // combined role — treated as PURCHASING + FINANCE + HR (see src/lib/role-utils.ts)
  CREW // ship crew — Purchase Request module only, no approval authority
  BOAT_CAPTAIN // Purchase Request module + approves their crew's requests + receives delivery links for their assignedYacht
  CRUISE_DIRECTOR // same scope as BOAT_CAPTAIN
}

enum BookingSource {
  AGENT
  DIRECT
}

enum TripType {
  PRIVATE_CHARTER
  OPEN_TRIP
}

enum BookingStatus {
  on_hold
  pending
  partially_paid
  fully_paid
  completed
  cancelled
  confirmed
  pending_refund
}

enum OpenTripStatus {
  open
  closed
  full
  completed
  cancelled
}

enum MaintenanceStatus {
  scheduled
  in_progress
  completed
  cancelled
}

enum YachtStatus {
  available
  booked
  maintenance
}

enum InternalEventType {
  DOCKING
  CROSSING
  OVERHAUL
  COMPANY_NEED
}

enum VoucherType {
  PERCENTAGE
  FIXED
}

enum WaitingListStatus {
  waiting
  promoted
  cancelled
}

enum PaymentStatus {
  requested
  invoice_ready
  pending_confirmation
  confirmed
  rejected
  cancelled
  refunded
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                                     String                      @id @default(cuid())
  email                                  String                      @unique
  name                                   String?
  password                               String
  role                                   Role                        @default(SALES)
  // For PURCHASING-role users only: which division's PRs they're responsible for (see
  // PurchaseRequestDivision). Null means unassigned — an unassigned Purchasing user sees
  // and gets notified about every PR regardless of division, same as before this field
  // existed, so this stays fully backward-compatible until an admin actually sets it.
  purchasingDivision                     PurchaseRequestDivision?
  // For BOAT_CAPTAIN/CRUISE_DIRECTOR-role users only: which yacht they're captain/director
  // of — used to route auto-generated PO/Transfer receive links to the right person only
  // (e.g. Otium's captain never gets notified about a delivery to another yacht).
  assignedYachtId                        String?
  assignedYacht                          Yacht?                      @relation(fields: [assignedYachtId], references: [id], onDelete: SetNull)
  createdAt                              DateTime                    @default(now())
  updatedAt                              DateTime                    @updatedAt
  bookings                               Booking[]                   @relation("SalespersonBookings")
  managedAgents                          Agent[]                     @relation("AgentSalesperson")
  waitingListItems                       WaitingList[]
  stockMovements                         StockMovement[]
  purchaseRequests                       PurchaseRequest[]           @relation("PRRequestedBy")
  purchaseRequestsApproved               PurchaseRequest[]           @relation("PRApprovedBy")
  leaveRequestsSubmitted                 LeaveRequest[]              @relation("LeaveRequestedBy")
  leaveRequestsDecided                   LeaveRequest[]              @relation("LeaveDecidedBy")
  probationReviewsRequested              ProbationReview[]           @relation("ProbationRequestedBy")
  probationReviewsHrDecided              ProbationReview[]           @relation("ProbationHrDecided")
  probationReviewsManagementDecided      ProbationReview[]           @relation("ProbationManagementDecided")
  purchaseRequestsVerified               PurchaseRequest[]           @relation("PRVerifiedBy")
  purchaseRequestsConverted              PurchaseRequest[]           @relation("PRConvertedBy")
  purchaseRequestsRejected               PurchaseRequest[]           @relation("PRRejectedBy")
  purchaseRequestsCancelled              PurchaseRequest[]           @relation("PRCancelledBy")
  purchaseRequestItemQuotationsSubmitted PurchaseRequestItem[]       @relation("PRItemQuotationSubmittedBy")
  purchaseRequestItemQuotationsToApprove PurchaseRequestItem[]       @relation("PRItemQuotationApprover")
  purchaseRequestItemQuotationsApproved  PurchaseRequestItem[]       @relation("PRItemQuotationApprovedBy")
  purchaseRequestItemQuotationsRejected  PurchaseRequestItem[]       @relation("PRItemQuotationRejectedBy")
  purchaseRequestItemsVerifyRejected     PurchaseRequestItem[]       @relation("PRItemVerifyRejectedBy")
  purchaseOrdersCreated                  PurchaseOrder[]
  goodsReceipts                          GoodsReceipt[]
  transfersDispatched                    StockTransfer[]             @relation("TransferDispatch")
  transfersReceived                      StockTransfer[]             @relation("TransferReceive")
  transfersExpectedReceive               StockTransfer[]             @relation("TransferExpectedReceive")
  inventoryExceptionsResolved            InventoryException[]        @relation("ExceptionResolvedBy")
  crewRequests                           CrewRequest[]
  stockCountsBy                          StockCount[]                @relation("StockCountBy")
  stockCountsApproved                    StockCount[]                @relation("StockCountApprove")
  poPaymentRequestsMade                  POPaymentRequest[]          @relation("POPaymentRequestedBy")
  poPaymentRequestsPaid                  POPaymentRequest[]          @relation("POPaymentPaidBy")
  poReimbursementsMade                   POReimbursement[]           @relation("POReimbursementRequestedBy")
  poReimbursementsPaid                   POReimbursement[]           @relation("POReimbursementPaidBy")
  poFollowUpsCreated                     PurchaseFollowUp[]          @relation("POFollowUpCreatedBy")
  poFollowUpsEscalatedTo                 PurchaseFollowUp[]          @relation("POFollowUpEscalatedTo")
  purchaseQuotationsCreated              PurchaseQuotation[]
  deliveryFeesCreated                    DeliveryFee[]
  deliveryFeePaymentRequestsMade         DeliveryFeePaymentRequest[] @relation("DeliveryFeePaymentRequestedBy")
  deliveryFeePaymentRequestsPaid         DeliveryFeePaymentRequest[] @relation("DeliveryFeePaymentPaidBy")
  deliveryFeeReimbursementsMade          DeliveryFeeReimbursement[]  @relation("DeliveryFeeReimbursementRequestedBy")
  deliveryFeeReimbursementsPaid          DeliveryFeeReimbursement[]  @relation("DeliveryFeeReimbursementPaidBy")
  agentLeadsPromoted                     AgentLead[]                 @relation("AgentLeadPromotedBy")
  mediaFilesUploaded                     MediaFile[]
  promosCreated                          Promo[]
  employeeProfile                        Employee?
  pushSubscriptions                      PushSubscription[]
  payrollPeriodsCreated                  PayrollPeriod[]             @relation("PayrollCreatedBy")
  payrollPeriodsSubmitted                PayrollPeriod[]             @relation("PayrollSubmittedBy")
  payrollPeriodsApproved                 PayrollPeriod[]             @relation("PayrollApprovedBy")
  payrollPeriodsRejected                 PayrollPeriod[]             @relation("PayrollRejectedBy")
  payrollPeriodsPaid                     PayrollPeriod[]             @relation("PayrollPaidBy")
  payrollSettingsUpdated                 PayrollSettings[]           @relation("PayrollSettingsUpdatedBy")
  attendanceRecordsSet                   AttendanceRecord[]          @relation("AttendanceSetBy")
  nationalHolidaysCreated                NationalHoliday[]
  loanRequestsMade                       LoanRequest[]               @relation("LoanRequestedBy")
  loanHrDecisions                        LoanRequest[]               @relation("LoanHrDecidedBy")
  loanFinanceDecisions                   LoanRequest[]               @relation("LoanFinanceDecidedBy")
  loanSpecialDecisions                   LoanRequest[]               @relation("LoanSpecialDecidedBy")
  internalEventsCreated                  InternalEvent[]

  @@index([assignedYachtId])
}

model Customer {
  id                   String               @id @default(cuid())
  name                 String
  firstName            String?
  lastName             String?
  gender               String?
  email                String?
  phone                String?
  passport             String?
  dateOfBirth          DateTime?
  isChild              Boolean              @default(false)
  address              String?
  dietaryRequirements  String?
  allergies            String?
  equipmentSizes       String?
  operationalNotes     String?
  nationality          String?
  passportExpiry       DateTime?
  emergencyContact     String?
  drinkPreferences     String?
  guestFormToken       String?              @unique
  guestFormExpiresAt   DateTime?
  freshsalesContactId  String?              @unique
  medicalData          Json?
  foodData             Json?
  drinksData           Json?
  divingData           Json?
  surfingData          Json?
  passportImage        String?
  deletedAt            DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  bookings             Booking[]
  guestOf              BookingGuest[]
  waitingListItems     WaitingList[]
  waitingListHistories WaitingListHistory[] @relation("WaitingListHistoryCustomer")
  inquiries            Inquiry[]
  pageViews            PageView[]

  @@index([deletedAt])
  @@index([name])
  @@index([email])
  @@index([createdAt])
}

model Lead {
  id                  String    @id @default(cuid())
  name                String
  firstName           String?
  lastName            String?
  nationality         String?
  email               String?
  phone               String?
  notes               String?
  freshsalesContactId String?   @unique
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  inquiries Inquiry[]
  pageViews PageView[]

  @@index([deletedAt])
  @@index([name])
  @@index([email])
  @@index([createdAt])
}

// One row per page load on the tenant's website, reported by the client-side
// tracker in functions.php. Rows start unowned (leadId/customerId both null,
// tied only to the anonymous visitorId cookie) and get retroactively linked
// to whichever Lead/Customer a CF7 submission resolves to — see the visitorId
// handling in POST /api/webhooks/cf7. This is what builds the "visitor
// journey" view Freshsales shows on a contact's timeline.
model PageView {
  id         String   @id @default(cuid())
  visitorId  String
  leadId     String?
  customerId String?
  url        String
  referrer   String?
  title      String?
  occurredAt DateTime
  createdAt  DateTime @default(now())

  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([visitorId])
  @@index([leadId])
  @@index([customerId])
  @@index([occurredAt])
}

// One row per form/inquiry submission — links to whichever of Lead/Customer
// currently owns it (exactly one of leadId/customerId set; enforced in app
// code, not a DB constraint, matching this schema's other either/or relations).
// Reassigned from leadId to customerId when a Lead converts into a Guest via
// booking creation — see POST /api/bookings.
model Inquiry {
  id                 String    @id @default(cuid())
  source             String
  leadId             String?
  customerId         String?
  checkInDate        DateTime?
  checkOutDate       DateTime?
  guestCount         Int?
  tripType           String?
  message            String?
  website            String? // domain of the page the form was submitted from, e.g. "samaraliveaboard.com"
  url                String? // full URL of the page the form was submitted from
  // "Original" touch — first_source/first_medium/first_campaign in Freshsales.
  // Filled from the form's ft_* fields (its own first-touch capture, persisted
  // client-side e.g. via cookie across the visitor's first-ever session).
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  utmTerm            String?
  utmContent         String?
  gclid              String?
  gbraid             String? // Google Ads' iOS/App-attribution equivalent of gclid
  wbraid             String? // Google Ads' web-conversion equivalent of gclid (privacy sandbox)
  fbclid             String? // Meta/Facebook click ID
  leadSource         String? // Freshsales "Lead Source" (cf_lead_source)
  refererField       String? // Freshsales "Referer Field" (cf_referer_field)
  mobileNumberBackup String? // Freshsales "Mobile number backup" (cf_mobile_number_backup)
  reference          String? // Freshsales "Reference" (cf_reference)
  // "Created from" touch — last_source/last_medium/last_campaign in Freshsales.
  // Filled from the form's bare utm_*/gclid/etc fields — this submission's own
  // traffic source, as opposed to the visitor's very first touch above.
  lastSource         String?
  lastMedium         String?
  lastCampaign       String?
  lastTerm           String?
  lastContent        String?
  lastGclid          String?
  lastGbraid         String?
  lastWbraid         String?
  lastFbclid         String?
  // "Most recent" touch — latest_source/latest_medium/latest_campaign in Freshsales
  latestSource       String?
  latestMedium       String?
  latestCampaign     String?
  rawPayload         Json?
  createdAt          DateTime  @default(now())

  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([customerId])
  @@index([createdAt])
}

model Agent {
  id                       String                 @id @default(cuid())
  name                     String
  commission               Float                  @default(0)
  commissionOpenTrip       Float                  @default(0)
  commissionPrivateCharter Float                  @default(0)
  isActive                 Boolean                @default(true)
  country                  String?
  address                  String?
  email                    String?
  whatsapp                 String?
  note                     String?
  website                  String?
  instagram                String?
  source                   String?
  currentCondition         String?
  contract                 String?
  contractFile             String?
  contractFileName         String?
  calendarToken            String?                @unique
  calendarActive           Boolean                @default(false)
  portalPasswordHash       String?
  portalPasswordSetAt      DateTime?
  portalPasswordSetById    String?
  portalActive             Boolean                @default(false)
  salespersonId            String?
  salesperson              User?                  @relation("AgentSalesperson", fields: [salespersonId], references: [id], onDelete: SetNull)
  bookings                 Booking[]
  contacts                 AgentContact[]
  calendarAccessLogs       CalendarAccessLog[]
  portalAccessLogs         PortalAccessLog[]
  leadsPromoted            AgentLead[]
  visibleCategories        AgentVisibleCategory[]
  // Clawback (hutang) — a running debt this agent owes back to us, e.g. from a prior
  // over-payment. Set/managed by Finance (or Admin) only — see AgentClawbackEntry, whose
  // signed `amount` sum IS the current balance (append-only ledger, same convention as
  // POPaymentRequest/POReimbursement — no separate mutable balance field to drift out of sync).
  // clawbackRatePerNight is the global fallback rate; AgentClawbackRate rows are more
  // specific per-yacht/per-trip-type overrides (same "default + overrides" shape as the
  // destination rate card on CabinPricingTier).
  clawbackRatePerNight     Float                  @default(0)
  clawbackEntries          AgentClawbackEntry[]
  clawbackRates            AgentClawbackRate[]
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  @@index([salespersonId])
  @@index([name])
}

model AgentClawbackEntry {
  id              String   @id @default(cuid())
  agentId         String
  // Positive = debt added (agent now owes more — a manual Finance entry). Negative = a
  // deduction that pays the debt down, either automatic (set at booking creation, from
  // the applicable clawback rate × nights, capped at the outstanding balance) or a manual
  // adjustment by Finance.
  amount          Float
  bookingId       String? // set only for automatic per-booking deductions
  note            String? // why this entry exists — required for manual entries
  createdByUserId String?
  createdByName   String?
  createdAt       DateTime @default(now())

  agent   Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([agentId])
  @@index([bookingId])
}

// A more specific clawback rate than Agent.clawbackRatePerNight — null yachtId/tripType
// means "any yacht"/"any trip type" respectively, so a row can be as broad or narrow as
// needed. At booking time the most specific matching row wins (yacht+tripType > yacht-only
// > tripType-only), falling back to Agent.clawbackRatePerNight if nothing matches at all.
model AgentClawbackRate {
  id           String    @id @default(cuid())
  agentId      String
  yachtId      String?
  tripType     TripType?
  ratePerNight Float
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  agent Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  yacht Yacht? @relation(fields: [yachtId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([yachtId])
}

model CalendarAccessLog {
  id           String   @id @default(cuid())
  agentId      String
  agent        Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  ip           String?
  userAgent    String?
  isSuspicious Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([agentId])
  @@index([createdAt])
}

// One row per successful Agent Portal login (not per page view) — logged from
// POST /api/agent-portal/login so staff can see when an agent last logged in, from
// where, and flag anything that looks off.
model PortalAccessLog {
  id           String   @id @default(cuid())
  agentId      String
  agent        Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  ip           String?
  userAgent    String?
  isSuspicious Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([agentId])
  @@index([createdAt])
}

model AgentContact {
  id          String    @id @default(cuid())
  agentId     String
  name        String
  email       String?
  whatsapp    String?
  jobTitle    String?
  dateOfBirth DateTime?
  addedById   String?
  addedByName String?
  agent       Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  bookings    Booking[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([agentId])
}

enum AgentLeadStatus {
  NEW
  PROMOTED
  DISCARDED
}

// Staging area for agent contacts pulled from an external CRM (Freshsales) before
// they become real Agent records. Contacts sharing the same display_name in the
// source system are grouped into one AgentLead with multiple AgentLeadContact rows
// (e.g. "Nicholson Yachts" with two different emails) — reviewed and promoted by
// hand so the real Agent table never gets polluted with unqualified/duplicate leads.
model AgentLead {
  id              String             @id @default(cuid())
  name            String             @unique
  status          AgentLeadStatus    @default(NEW)
  promotedAgentId String?
  promotedAgent   Agent?             @relation(fields: [promotedAgentId], references: [id], onDelete: SetNull)
  promotedAt      DateTime?
  promotedById    String?
  promotedBy      User?              @relation("AgentLeadPromotedBy", fields: [promotedById], references: [id], onDelete: SetNull)
  discardedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  contacts        AgentLeadContact[]

  @@index([status])
}

model AgentLeadContact {
  id                  String   @id @default(cuid())
  agentLeadId         String
  freshsalesContactId String   @unique
  name                String
  email               String?
  whatsapp            String?
  jobTitle            String?
  salesOwnerName      String?
  createdAt           DateTime @default(now())

  agentLead AgentLead @relation(fields: [agentLeadId], references: [id], onDelete: Cascade)

  @@index([agentLeadId])
}

model Yacht {
  id                 String                  @id @default(cuid())
  name               String
  model              String?
  year               Int?
  capacity           Int
  cabinCount         Int                     @default(0)
  length             Float?
  description        String?
  hourlyRate         Float
  dailyRate          Float
  extraBedTiers      Json                    @default("[]")
  canDiving          Boolean                 @default(false)
  canSurfing         Boolean                 @default(false)
  status             YachtStatus             @default(available)
  image              String?
  tagline            String?
  type               String?
  // Manual display order for the Agent Portal yacht picker (and anywhere else the fleet is
  // listed) — lower shows first. Defaults to 0 so existing/new yachts fall back to name-sort.
  sortOrder          Int                     @default(0)
  deletedAt          DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  bookings           Booking[]
  crew               Crew[]
  cabins             Cabin[]
  openTrips          OpenTrip[]
  maintenances       Maintenance[]
  expenses           Expense[]
  waitingListItems   WaitingList[]
  stockLocations     StockLocation[]
  crewRequests       CrewRequest[]
  cashierSales       CashierSale[]
  destinationPrices  YachtDestinationPrice[]
  mediaFiles         MediaFile[]
  mediaFolders       MediaFolder[]
  promos             Promo[]
  agentClawbackRates AgentClawbackRate[]
  posMenuItems       PosMenuItem[]
  posPackages        PosPackage[]
  posDiscounts       PosDiscount[]
  documents          LegalDocument[]
  internalEvents     InternalEvent[]
  assignedUsers      User[]
}

enum MediaFileType {
  image
  document
  video
}

// Marketing-managed — rename/add/remove freely from the ERP, not a fixed enum.
model MediaCategory {
  id        String   @id @default(cuid())
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mediaFiles      MediaFile[]
  mediaFolders    MediaFolder[]
  agentVisibility AgentVisibleCategory[]
}

model MediaFile {
  id           String        @id @default(cuid())
  yachtId      String?
  yacht        Yacht?        @relation(fields: [yachtId], references: [id], onDelete: Cascade)
  categoryId   String
  category     MediaCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  type         MediaFileType
  name         String
  url          String
  sizeBytes    Int?
  mimeType     String?
  folderId     String?
  folder       MediaFolder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  sortOrder    Int           @default(0)
  uploadedById String
  uploadedBy   User          @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([yachtId])
  @@index([categoryId])
  @@index([folderId])
}

// A folder can nest inside another folder (parentId, self-relation) to unlimited depth —
// null parentId means it sits at the top level of its category. Persisted independently of
// MediaFile so an empty folder still shows up before anything is uploaded into it.
model MediaFolder {
  id         String        @id @default(cuid())
  yachtId    String?
  yacht      Yacht?        @relation(fields: [yachtId], references: [id], onDelete: Cascade)
  categoryId String
  category   MediaCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  parentId   String?
  parent     MediaFolder?  @relation("MediaFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   MediaFolder[] @relation("MediaFolderTree")
  name       String
  createdAt  DateTime      @default(now())

  files MediaFile[]

  @@index([yachtId])
  @@index([categoryId])
  @@index([parentId])
}

// Multiple promo drafts allowed per scope (yachtId = null is "General", shown on Agent Portal
// login; yachtId = <id> is that yacht's, shown when an agent picks it) — but at most one row
// per scope has isActive: true at a time. Activating one deactivates its siblings (enforced in
// the PATCH route via a transaction, not a DB constraint, since "only one active" is a
// cross-row invariant Postgres unique indexes can't express here).
model Promo {
  id          String   @id @default(cuid())
  yachtId     String?
  yacht       Yacht?   @relation(fields: [yachtId], references: [id], onDelete: Cascade)
  title       String
  description String?
  imageUrl    String?
  ctaLabel    String?
  ctaUrl      String?
  isActive    Boolean  @default(false)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([yachtId])
}

// Per-agent override of which Media Kit categories they see in the Agent Portal. An agent
// with zero rows here sees every category (default, unrestricted) — only once at least one
// row exists does this become an explicit allow-list. See AgentPortalPage MediaKitScreen.
model AgentVisibleCategory {
  id         String        @id @default(cuid())
  agentId    String
  agent      Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  categoryId String
  category   MediaCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())

  @@unique([agentId, categoryId])
}

model Destination {
  id        String    @id @default(cuid())
  name      String    @unique
  region    String?
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  yachtPrices       YachtDestinationPrice[]
  openTrips         OpenTrip[]
  bookings          Booking[]
  cabinPricingTiers CabinPricingTier[]
}

model YachtDestinationPrice {
  id            String      @id @default(cuid())
  yachtId       String
  destinationId String
  price         Float
  relocationFee Float?
  yacht         Yacht       @relation(fields: [yachtId], references: [id], onDelete: Cascade)
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([yachtId, destinationId])
}

model Cabin {
  id           String             @id @default(cuid())
  yachtId      String
  name         String
  capacity     Int                @default(2)
  price        Float              @default(0)
  deck         String?
  bedType      String?
  extraBeds    Int                @default(0)
  yacht        Yacht              @relation(fields: [yachtId], references: [id], onDelete: Cascade)
  guests       BookingGuest[]
  pricingTiers CabinPricingTier[]

  @@index([yachtId])
}

model CabinPricingTier {
  id            String       @id @default(cuid())
  cabinId       String
  // null = fallback rate that applies regardless of destination (the original behavior,
  // before per-destination rate cards existed). A row with a destinationId set is a more
  // specific override for that destination + nights combo; lookups should prefer a match
  // with destinationId first and fall back to the null-destination row.
  destinationId String?
  nights        Int
  price         Float
  cabin         Cabin        @relation(fields: [cabinId], references: [id], onDelete: Cascade)
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([cabinId, destinationId, nights])
  @@map("cabin_pricing_tiers")
}

model OpenTrip {
  id               String         @id @default(cuid())
  title            String
  description      String?
  yachtId          String
  startDate        DateTime
  endDate          DateTime
  destination      String
  destinationId    String?
  region           String?
  departurePort    String?
  arrivalPort      String?
  pricePerCabin    Float          @default(0)
  maxCapacity      Int            @default(0)
  status           OpenTripStatus @default(open)
  closedReason     String?
  bookings         Booking[]
  waitingListItems WaitingList[]
  yacht            Yacht          @relation(fields: [yachtId], references: [id], onDelete: Cascade)
  destinationRef   Destination?   @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([yachtId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([destinationId])
}

model Booking {
  id                            String               @id @default(cuid())
  bookingCode                   String               @unique
  customerId                    String
  agentId                       String?
  agentContactId                String?
  openTripId                    String?
  source                        BookingSource        @default(DIRECT)
  tripType                      TripType             @default(PRIVATE_CHARTER)
  yachtId                       String?
  startDate                     DateTime
  endDate                       DateTime
  destination                   String?
  destinationId                 String?
  status                        BookingStatus        @default(pending)
  totalPrice                    Float
  depositPaid                   Float                @default(0)
  discount                      Float                @default(0)
  depositDueDate                DateTime?
  finalDueDate                  DateTime?
  // When set, the invoice PDF shows this date instead of the live depositDueDate/finalDueDate above —
  // lets staff extend a due date internally without amending an already-issued invoice.
  depositDueDateInvoiceOverride DateTime?
  finalDueDateInvoiceOverride   DateTime?
  holdUntil                     DateTime?
  guestCount                    Int                  @default(1)
  crewRequired                  Boolean              @default(false)
  hasDiving                     Boolean              @default(false)
  hasSurfing                    Boolean              @default(false)
  hasPhotoPackage               Boolean              @default(false)
  masterFormToken               String?              @unique
  masterFormExpiresAt           DateTime?
  salesperson                   String?
  salespersonId                 String?
  notes                         String?
  cancelReason                  String?
  refundStatus                  String?
  refundDecision                String?
  refundReason                  String?
  refundProof                   String?
  refundConfirmedAt             DateTime?
  refundConfirmedBy             String?
  voucherCode                   String?
  currency                      String               @default("USD")
  exchangeRate                  Float?
  createdAt                     DateTime             @default(now())
  updatedAt                     DateTime             @updatedAt
  customer                      Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  agent                         Agent?               @relation(fields: [agentId], references: [id], onDelete: SetNull)
  agentContact                  AgentContact?        @relation(fields: [agentContactId], references: [id], onDelete: SetNull)
  yacht                         Yacht?               @relation(fields: [yachtId], references: [id])
  openTrip                      OpenTrip?            @relation(fields: [openTripId], references: [id], onDelete: SetNull)
  destinationRef                Destination?         @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  salespersonUser               User?                @relation("SalespersonBookings", fields: [salespersonId], references: [id], onDelete: SetNull)
  guests                        BookingGuest[]
  services                      BookingService[]
  payments                      Payment[]
  expenses                      Expense[]
  notifications                 Notification[]
  waitingList                   WaitingList[]        @relation("BookingWaitingList")
  clawbackEntries               AgentClawbackEntry[]
  slotHistory                   WaitingListHistory[] @relation("BookingSlotHistory")
  promotedWaitingLists          WaitingList[]        @relation("WaitingListPromotedBooking")
  cashierSales                  CashierSale[]
  purchaseOrders                PurchaseOrder[]
  purchaseRequests              PurchaseRequest[]

  @@index([status])
  @@index([openTripId, status])
  @@index([status, depositDueDate])
  @@index([customerId])
  @@index([startDate, endDate])
  @@index([yachtId])
  @@index([agentId])
  @@index([agentContactId])
  @@index([destinationId])
  @@index([salespersonId])
  @@index([createdAt])
}

